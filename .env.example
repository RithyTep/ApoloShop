# Database - PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/apoloshop"

# JWT Secret - Generate a secure random string (min 32 characters)
# Run: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-min-32-characters-here"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Exchange Rate (USD to KHR)
NEXT_PUBLIC_EXCHANGE_RATE="4100"

# Payment Integrations (optional)
ABA_MERCHANT_ID=""
WING_API_KEY=""
WING_API_SECRET=""

# Cloudflare R2 Storage
# Get these from Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="apoloshop"
R2_PUBLIC_URL=""  # e.g., https://pub-xxx.r2.dev or your custom domain
