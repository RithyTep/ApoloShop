  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([clientId])
  @@index([isActive])
  @@map("shop_customization")
  @@schema("apolo")
}

// ============================================
// SEARCH ANALYTICS
// ============================================

model SearchLog {
