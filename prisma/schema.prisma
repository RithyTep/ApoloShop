// Prisma Schema for ApoloShop CMS
// PostgreSQL database hosted on Neon (Vercel deployment)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["apolo"]
}

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String
  roleId       String    @map("role_id")
  role         Role      @relation(fields: [roleId], references: [id])
  isActive     Boolean   @default(true) @map("is_active")
  // Email verification fields
  emailVerified    Boolean   @default(false) @map("email_verified")
  emailVerifiedAt  DateTime? @map("email_verified_at")
  // Two-Factor Authentication (2FA) fields
  twoFactorEnabled Boolean   @default(false) @map("two_factor_enabled")
  twoFactorSecret  String?   @map("two_factor_secret") // Encrypted TOTP secret
  recoveryCodes    Json?     @map("recovery_codes") // Array of hashed recovery codes
  // Password security fields
  passwordChangedAt DateTime? @map("password_changed_at") // For password expiry reminders
  // Login notification preferences
  loginNotificationsEnabled Boolean @default(true) @map("login_notifications_enabled")
  // IP whitelisting for admin access
  allowedIPs   Json?     @map("allowed_ips") // Array of allowed IP addresses/CIDR ranges
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  sessions            Session[]
  passwordHistory     PasswordHistory[]
  socialAccounts      SocialAccount[]
  passwordResetTokens PasswordResetToken[]
  emailVerifyTokens   EmailVerifyToken[]

  @@map("users")
  @@schema("apolo")
}

// System roles: super_admin, admin, manager, staff
model Role {
  id          String   @id @default(cuid())
  name        String   @unique // super_admin, admin, manager, staff
  displayName String   @default("") @map("display_name") // Human-readable name
  description String?  // Role description
  permissions Json     // Legacy: { "products": ["read", "write", "delete"], ... }
  isSystem    Boolean  @default(false) @map("is_system") // System roles cannot be deleted
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       User[]
  rolePermissions RolePermission[]

  @@map("roles")
  @@schema("apolo")
}

// Permission model for granular access control
model Permission {
  id          String   @id @default(cuid())
  name        String   @unique // e.g., "products:read", "orders:write"
  resource    String   // e.g., "products", "orders", "customers"
  action      String   // e.g., "read", "write", "delete"
  displayName String   @map("display_name") // Human-readable name
  description String?  // Permission description
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@index([resource])
  @@index([action])
  @@map("permissions")
  @@schema("apolo")
}

// Junction table for Role <-> Permission many-to-many
model RolePermission {
  id           String     @id @default(cuid())
  roleId       String     @map("role_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @map("created_at")

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
  @@schema("apolo")
}

model Session {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  // Device and location info
  deviceName   String?  @map("device_name") // e.g., "Chrome on Windows", "Mobile Safari on iPhone"
  deviceType   String?  @map("device_type") // "desktop", "mobile", "tablet"
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent") @db.Text
  location     String?  // Approximate location from IP (e.g., "Phnom Penh, KH")
  // Session timestamps
  lastActive   DateTime @default(now()) @map("last_active")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  // Session status
  isRevoked    Boolean  @default(false) @map("is_revoked")
  revokedAt    DateTime? @map("revoked_at")
  isCurrent    Boolean  @default(false) @map("is_current") // Marked true for current request's session

  @@index([userId])
  @@index([token])
  @@index([lastActive])
  @@index([isRevoked])
  @@map("sessions")
  @@schema("apolo")
}

// Password history for preventing password reuse
model PasswordHistory {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdAt])
  @@map("password_history")
  @@schema("apolo")
}

// Login attempts for brute force protection
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String   // Email attempted (may not correspond to existing user)
  userId    String?  @map("user_id") // Optional: linked user if email matches
  ipAddress String   @map("ip_address")
  userAgent String?  @map("user_agent") @db.Text
  success   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@index([ipAddress])
  @@index([createdAt])
  @@index([email, success, createdAt])
  @@map("login_attempts")
  @@schema("apolo")
}

// Account lockout tracking
model AccountLockout {
  id           String    @id @default(cuid())
  userId       String    @unique @map("user_id")
  lockedAt     DateTime  @default(now()) @map("locked_at")
  lockedUntil  DateTime  @map("locked_until")
  failedAttempts Int     @default(5) @map("failed_attempts")
  ipAddress    String?   @map("ip_address") // IP that triggered the lockout
  unlockedAt   DateTime? @map("unlocked_at") // Manual unlock timestamp
  unlockedBy   String?   @map("unlocked_by") // Admin who unlocked

  @@index([userId])
  @@index([lockedUntil])
  @@map("account_lockouts")
  @@schema("apolo")
}

// Password reset tokens
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique // Hashed token (SHA-256)
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at") // Null until token is used
  ipAddress String?  @map("ip_address") // IP that requested the reset
  userAgent String?  @map("user_agent") @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("password_reset_tokens")
  @@schema("apolo")
}

// Email verification tokens
model EmailVerifyToken {
  id         String    @id @default(cuid())
  userId     String?   @map("user_id")
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId String?   @map("customer_id")
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  email      String    // The email to verify (may differ from current email)
  token      String    @unique // Hashed token (SHA-256)
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at") // Null until token is used
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent") @db.Text
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([customerId])
  @@index([token])
  @@index([email])
  @@index([expiresAt])
  @@map("email_verify_tokens")
  @@schema("apolo")
}

// ============================================
// SOCIAL ACCOUNTS (OAuth)
// ============================================

enum OAuthProvider {
  GOOGLE
  FACEBOOK

  @@schema("apolo")
}

model SocialAccount {
  id              String        @id @default(cuid())
  userId          String?       @map("user_id") // Linked admin user (optional)
  user            User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId      String?       @map("customer_id") // Linked customer (optional)
  customer        Customer?     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  provider        OAuthProvider
  providerUserId  String        @map("provider_user_id") // ID from OAuth provider
  email           String?       // Email from OAuth provider
  name            String?       // Display name from OAuth provider
  avatarUrl       String?       @map("avatar_url")
  // Token storage (encrypted)
  accessToken     String?       @map("access_token") @db.Text
  refreshToken    String?       @map("refresh_token") @db.Text
  tokenExpiresAt  DateTime?     @map("token_expires_at")
  // Metadata
  rawProfile      Json?         @map("raw_profile") // Full profile data from provider
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@unique([provider, providerUserId]) // One account per provider per user
  @@index([userId])
  @@index([customerId])
  @@index([provider])
  @@index([email])
  @@map("social_accounts")
  @@schema("apolo")
}

// ============================================
// PRODUCT CATALOG
// ============================================

model Category {
  id        String    @id @default(cuid())
  nameEn    String    @map("name_en")
  nameKh    String    @map("name_kh")
  slug      String    @unique
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  products  Product[]

  @@map("categories")
  @@schema("apolo")
}

model Product {
  id            String    @id @default(cuid())
  clientId      String?   @map("client_id")
  client        Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  nameEn        String    @map("name_en")
  nameKh        String    @map("name_kh")
  descriptionEn String?   @map("description_en") @db.Text
  descriptionKh String?   @map("description_kh") @db.Text
  priceUsd      Decimal   @map("price_usd") @db.Decimal(10, 2)
  priceKhr      Int       @map("price_khr")
  categoryId    String    @map("category_id")
  category      Category  @relation(fields: [categoryId], references: [id])
  sku           String    @unique
  imageUrl      String?   @map("image_url")
  images        Json?     // Array of additional image URLs
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  inventory     Inventory?
  orderItems    OrderItem[]
  wishlists     Wishlist[]
  reviews       Review[]

  @@index([clientId])
  @@index([categoryId])
  @@index([sku])
  @@index([isActive])
  @@map("products")
  @@schema("apolo")
}

model Inventory {
  id          String   @id @default(cuid())
  productId   String   @unique @map("product_id")
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity    Int      @default(0)
  minLevel    Int      @default(10) @map("min_level")
  lastUpdated DateTime @default(now()) @map("last_updated")

  @@map("inventory")
  @@schema("apolo")
}

// ============================================
// CUSTOMERS
// ============================================

model Customer {
  id        String   @id @default(cuid())
  clientId  String?  @map("client_id")
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  phone     String   @unique
  email     String?
  // Email verification fields
  emailVerified    Boolean   @default(false) @map("email_verified")
  emailVerifiedAt  DateTime? @map("email_verified_at")
  notes     String?  @db.Text
  tags      Json?    // ["VIP", "Frequent Buyer"]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orders                  Order[]
  wishlists               Wishlist[]
  reviews                 Review[]
  notificationPreferences NotificationPreference[]
  socialAccounts          SocialAccount[]
  emailVerifyTokens       EmailVerifyToken[]
  shippingAddresses       ShippingAddress[]

  @@index([clientId])
  @@index([phone])
  @@map("customers")
  @@schema("apolo")
}

// Shipping Address for returning customers
model ShippingAddress {
  id          String    @id @default(cuid())
  customerId  String?   @map("customer_id")
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  guestId     String?   @map("guest_id") // For guest checkout
  label       String?   // "Home", "Work", etc.
  fullName    String    @map("full_name")
  phone       String
  province    String?   // Province/State
  district    String?   // District/City
  commune     String?   // Commune/Sangkat
  addressLine String    @map("address_line") @db.Text // Street address
  landmark    String?   // Nearby landmark
  isDefault   Boolean   @default(false) @map("is_default")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([guestId])
  @@index([isDefault])
  @@map("shipping_addresses")
  @@schema("apolo")
}

// ============================================
// ORDERS & PAYMENTS
// ============================================

enum OrderStatus {
  NEW
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED

  @@schema("apolo")
}

enum OrderChannel {
  WEBSITE
  TELEGRAM
  MESSENGER
  PHONE
  WALK_IN

  @@schema("apolo")
}

enum Currency {
  USD
  KHR

  @@schema("apolo")
}

model Order {
  id          String       @id @default(cuid())
  clientId    String?      @map("client_id")
  client      Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  orderNumber String       @unique @map("order_number")
  customerId  String       @map("customer_id")
  customer    Customer     @relation(fields: [customerId], references: [id])
  status      OrderStatus  @default(NEW)
  totalUsd    Decimal      @map("total_usd") @db.Decimal(10, 2)
  totalKhr    Int          @map("total_khr")
  currency    Currency     @default(USD)
  channel     OrderChannel @default(WEBSITE)
  note        String?      @db.Text
  promotionId String?      @map("promotion_id")
  promotion   Promotion?   @relation(fields: [promotionId], references: [id])
  discountUsd Decimal?     @map("discount_usd") @db.Decimal(10, 2)
  discountKhr Int?         @map("discount_khr")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  items       OrderItem[]
  payments    Payment[]

  @@index([clientId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
  @@schema("apolo")
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String   @map("order_id")
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?  @map("product_id")
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String?  @map("product_name") // Preserved when product is deleted
  quantity    Int
  priceUsd    Decimal  @map("price_usd") @db.Decimal(10, 2)
  priceKhr    Int      @map("price_khr")

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
  @@schema("apolo")
}

enum PaymentMethod {
  CASH
  ABA_KHQR
  WING
  PAYWAY
  BANK_TRANSFER

  @@schema("apolo")
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED

  @@schema("apolo")
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String        @map("order_id")
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method        PaymentMethod
  amount        Decimal       @db.Decimal(10, 2)
  currency      Currency
  status        PaymentStatus @default(PENDING)
  transactionId String?       @map("transaction_id")
  metadata      Json?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([transactionId])
  @@map("payments")
  @@schema("apolo")
}

// ============================================
// PROMOTIONS
// ============================================

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT

  @@schema("apolo")
}

model Promotion {
  id        String        @id @default(cuid())
  code      String        @unique
  type      PromotionType
  value     Decimal       @db.Decimal(10, 2)
  minOrder  Decimal?      @map("min_order") @db.Decimal(10, 2)
  maxUses   Int?          @map("max_uses")
  usedCount Int           @default(0) @map("used_count")
  startDate DateTime      @map("start_date")
  endDate   DateTime      @map("end_date")
  isActive  Boolean       @default(true) @map("is_active")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  orders    Order[]

  @@index([code])
  @@index([isActive])
  @@map("promotions")
  @@schema("apolo")
}

// ============================================
// COUPONS & DISCOUNTS
// ============================================

enum CouponType {
  PERCENTAGE       // Percentage off total
  FIXED_AMOUNT     // Fixed dollar/riel amount off
  FREE_SHIPPING    // Free shipping discount
  BOGO             // Buy One Get One (applies to cheapest item)

  @@schema("apolo")
}

model Coupon {
  id            String     @id @default(cuid())
  code          String     @unique // Unique coupon code (uppercase)
  type          CouponType
  value         Decimal    @db.Decimal(10, 2) // Percentage (0-100) or fixed amount
  // Restrictions
  minOrderUsd   Decimal?   @map("min_order_usd") @db.Decimal(10, 2) // Minimum order value in USD
  maxDiscountUsd Decimal?  @map("max_discount_usd") @db.Decimal(10, 2) // Max discount cap for percentage coupons
  // Usage limits
  maxUses       Int?       @map("max_uses") // Total uses allowed (null = unlimited)
  maxUsesPerCustomer Int?  @map("max_uses_per_customer") // Uses per customer (null = unlimited)
  usedCount     Int        @default(0) @map("used_count") // Total times used
  // Validity period
  startsAt      DateTime   @map("starts_at")
  expiresAt     DateTime   @map("expires_at")
  // Status
  isActive      Boolean    @default(true) @map("is_active")
  // Optional: restrict to specific products/categories
  applicableProductIds Json? @map("applicable_product_ids") // Array of product IDs
  applicableCategoryIds Json? @map("applicable_category_ids") // Array of category IDs
  // Metadata
  description   String?    @db.Text // Internal description
  createdBy     String?    @map("created_by") // Admin who created
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  usages        CouponUsage[]

  @@index([code])
  @@index([isActive])
  @@index([expiresAt])
  @@map("coupons")
  @@schema("apolo")
}

// Track coupon usage per customer
model CouponUsage {
  id          String   @id @default(cuid())
  couponId    String   @map("coupon_id")
  coupon      Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  customerId  String?  @map("customer_id") // Null for guest checkouts
  guestId     String?  @map("guest_id") // For guest tracking
  orderId     String?  @map("order_id") // Link to the order
  discountUsd Decimal  @map("discount_usd") @db.Decimal(10, 2) // Actual discount applied
  discountKhr Int      @map("discount_khr")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([couponId])
  @@index([customerId])
  @@index([guestId])
  @@index([orderId])
  @@map("coupon_usages")
  @@schema("apolo")
}

// ============================================
// CMS CONTENT
// ============================================

enum ContentType {
  PAGE
  BLOG
  BANNER
  FAQ

  @@schema("apolo")
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@schema("apolo")
}

model CMSContent {
  id        String        @id @default(cuid())
  slug      String        @unique
  titleEn   String        @map("title_en")
  titleKh   String        @map("title_kh")
  contentEn String        @map("content_en") @db.Text
  contentKh String        @map("content_kh") @db.Text
  type      ContentType
  status    ContentStatus @default(DRAFT)
  metadata  Json?
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@index([type])
  @@index([status])
  @@map("cms_content")
  @@schema("apolo")
}

// ============================================
// SETTINGS
// ============================================

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
  @@schema("apolo")
}

// ============================================
// BUSINESS HOURS & HOLIDAYS
// ============================================

model BusinessHours {
  id        String   @id @default(cuid())
  dayOfWeek Int      @map("day_of_week") // 0=Sunday, 6=Saturday
  openTime  String?  @map("open_time")   // "09:00" or null if closed
  closeTime String?  @map("close_time")  // "22:00" or null if closed
  isOpen    Boolean  @default(true) @map("is_open")

  @@unique([dayOfWeek])
  @@map("business_hours")
  @@schema("apolo")
}

model Holiday {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  nameEn    String   @map("name_en")
  nameKh    String   @map("name_kh")
  isFullDay Boolean  @default(true) @map("is_full_day")
  openTime  String?  @map("open_time")
  closeTime String?  @map("close_time")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([date])
  @@map("holidays")
  @@schema("apolo")
}

// ============================================
// MULTI-TENANT CLIENT
// ============================================

model Client {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique // Used for subdomains: {slug}.apoloshop.com
  domain       String?  @unique // Custom domain: shop.example.com
  settings     Json?    // Client-specific settings (currency, language, etc.)
  // Theme fields for whitelabel branding
  primaryColor   String?  @map("primary_color")      // e.g., "oklch(0.72 0.16 356)"
  secondaryColor String?  @map("secondary_color")    // e.g., "oklch(0.65 0.15 250)"
  logoUrl        String?  @map("logo_url")           // URL to client's logo
  faviconUrl     String?  @map("favicon_url")        // URL to client's favicon
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  products     Product[]
  orders       Order[]
  customers    Customer[]
  customizations ShopCustomization[]
  subscription Subscription?

  @@index([slug])
  @@index([domain])
  @@index([isActive])
  @@map("clients")
  @@schema("apolo")
}

// ============================================
// SUBSCRIPTION & BILLING
// ============================================

enum SubscriptionPlan {
  FREE
  STARTER
  PRO

  @@schema("apolo")
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PAST_DUE

  @@schema("apolo")
}

model Subscription {
  id            String             @id @default(cuid())
  clientId      String             @unique @map("client_id")
  client        Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  plan          SubscriptionPlan   @default(FREE)
  status        SubscriptionStatus @default(ACTIVE)
  // Billing cycle
  currentPeriodStart DateTime      @map("current_period_start")
  currentPeriodEnd   DateTime      @map("current_period_end")
  // Usage tracking for limit enforcement
  productsUsed   Int               @default(0) @map("products_used")
  ordersThisMonth Int              @default(0) @map("orders_this_month")
  // External payment provider reference (for future integration)
  stripeCustomerId    String?      @map("stripe_customer_id")
  stripeSubscriptionId String?     @map("stripe_subscription_id")
  // Timestamps
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  cancelledAt   DateTime?          @map("cancelled_at")

  @@index([clientId])
  @@index([plan])
  @@index([status])
  @@map("subscriptions")
  @@schema("apolo")
}

// ============================================
// SHOP CUSTOMIZATION (White Label)
// ============================================

model ShopCustomization {
  id        String   @id @default(cuid())
  clientId  String?  @map("client_id")
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  version   Int      @default(1)
  isActive  Boolean  @default(true) @map("is_active")
  config    Json     // Full customization config (theme, sections, etc.)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([clientId])
  @@index([isActive])
  @@map("shop_customization")
  @@schema("apolo")
}

// ============================================
// SEARCH ANALYTICS
// ============================================

model SearchLog {
  id           String   @id @default(cuid())
  query        String
  resultsCount Int      @map("results_count")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([query])
  @@map("search_logs")
  @@schema("apolo")
}

// ============================================
// PRODUCT REVIEWS
// ============================================

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("apolo")
}

model Review {
  id         String       @id @default(cuid())
  productId  String       @map("product_id")
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String?      @map("customer_id")
  customer   Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  guestName  String?      @map("guest_name") // For guest reviews
  rating     Int          // 1-5 stars
  comment    String?      @db.Text
  status     ReviewStatus @default(PENDING)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  @@index([productId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("reviews")
  @@schema("apolo")
}

// ============================================
// WISHLIST
// ============================================

model Wishlist {
  id         String   @id @default(cuid())
  customerId String?  @map("customer_id")
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String   @map("product_id")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  guestId    String?  @map("guest_id") // For guest users (stored in localStorage)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([customerId, productId]) // One entry per customer-product pair
  @@unique([guestId, productId]) // One entry per guest-product pair
  @@index([customerId])
  @@index([guestId])
  @@index([productId])
  @@map("wishlists")
  @@schema("apolo")
}

// ============================================
// NOTIFICATION PREFERENCES
// ============================================

enum NotificationChannel {
  TELEGRAM
  EMAIL
  SMS

  @@schema("apolo")
}

model NotificationPreference {
  id           String   @id @default(cuid())
  customerId   String   @map("customer_id")
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  channel      NotificationChannel
  enabled      Boolean  @default(true)
  // Channel-specific identifiers
  telegramChatId String?  @map("telegram_chat_id")
  // Preferences for what to be notified about
  orderConfirmation Boolean @default(true) @map("order_confirmation")
  orderPreparing    Boolean @default(true) @map("order_preparing")
  orderReady        Boolean @default(true) @map("order_ready")
  orderCompleted    Boolean @default(true) @map("order_completed")
  orderCancelled    Boolean @default(true) @map("order_cancelled")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([customerId, channel])
  @@index([customerId])
  @@map("notification_preferences")
  @@schema("apolo")
}

model NotificationLog {
  id           String              @id @default(cuid())
  customerId   String              @map("customer_id")
  orderId      String?             @map("order_id")
  channel      NotificationChannel
  type         String              // e.g., "order_status_changed", "order_confirmed"
  message      String              @db.Text
  status       String              @default("sent") // "sent", "failed", "pending"
  errorMessage String?             @map("error_message") @db.Text
  sentAt       DateTime            @default(now()) @map("sent_at")

  @@index([customerId])
  @@index([orderId])
  @@index([sentAt])
  @@map("notification_logs")
  @@schema("apolo")
}

// ============================================
// AUDIT LOG
// ============================================

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  SETTINGS_CHANGE

  @@schema("apolo")
}

model AuditLog {
  id          String      @id @default(cuid())
  userId      String?     @map("user_id")
  userName    String?     @map("user_name") // Preserved in case user is deleted
  action      AuditAction
  resource    String      // e.g., "product", "order", "settings", "user"
  resourceId  String?     @map("resource_id")
  details     Json?       // Additional context (old/new values, etc.)
  ipAddress   String?     @map("ip_address")
  userAgent   String?     @map("user_agent") @db.Text
  createdAt   DateTime    @default(now()) @map("created_at")

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([resourceId])
  @@index([createdAt])
  @@map("audit_logs")
  @@schema("apolo")
}

// ============================================
// API KEYS FOR THIRD-PARTY INTEGRATIONS
// ============================================

model ApiKey {
  id           String    @id @default(cuid())
  clientId     String?   @map("client_id")
  name         String    // Human-readable name for the key
  keyHash      String    @unique @map("key_hash") // SHA-256 hash of the API key
  keyPrefix    String    @map("key_prefix") // First 8 chars for identification (ak_XXXXXXXX...)
  scopes       Json      // Array of scopes: ["read:products", "write:orders", etc.]
  // Rate limiting
  rateLimitPerMinute Int @default(60) @map("rate_limit_per_minute")
  // Usage tracking
  lastUsedAt   DateTime? @map("last_used_at")
  usageCount   Int       @default(0) @map("usage_count")
  // Key rotation
  previousKeyHash String? @map("previous_key_hash") // For key rotation without downtime
  previousKeyExpiresAt DateTime? @map("previous_key_expires_at")
  // Status
  isActive     Boolean   @default(true) @map("is_active")
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  // Metadata
  description  String?   @db.Text
  createdBy    String?   @map("created_by") // User ID who created the key

  @@index([clientId])
  @@index([keyHash])
  @@index([keyPrefix])
  @@index([isActive])
  @@map("api_keys")
  @@schema("apolo")
}

// API Key usage log for rate limiting and analytics
model ApiKeyUsageLog {
  id        String   @id @default(cuid())
  apiKeyId  String   @map("api_key_id")
  endpoint  String   // The endpoint that was accessed
  method    String   // HTTP method
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent") @db.Text
  statusCode Int?    @map("status_code")
  responseTime Int?  @map("response_time") // In milliseconds
  createdAt DateTime @default(now()) @map("created_at")

  @@index([apiKeyId])
  @@index([createdAt])
  @@index([apiKeyId, createdAt])
  @@map("api_key_usage_logs")
  @@schema("apolo")
}

// ============================================
// LOGIN ACTIVITY & SECURITY
// ============================================

// Login activity for tracking and notifying users of new logins
model LoginActivity {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  sessionId    String?  @map("session_id") // Reference to the session created
  // Device information
  deviceName   String?  @map("device_name") // e.g., "Chrome on Windows"
  deviceType   String?  @map("device_type") // "desktop", "mobile", "tablet"
  browser      String?  // Browser name
  os           String?  // Operating system
  // Location information
  ipAddress    String   @map("ip_address")
  country      String?  // Country from IP geolocation
  city         String?  // City from IP geolocation
  region       String?  // Region/state from IP geolocation
  // Tracking
  isNewDevice  Boolean  @default(false) @map("is_new_device")
  isNewLocation Boolean @default(false) @map("is_new_location")
  notificationSent Boolean @default(false) @map("notification_sent")
  // Security review
  markedSuspicious Boolean @default(false) @map("marked_suspicious")
  suspiciousAt DateTime? @map("suspicious_at")
  reviewedAt   DateTime? @map("reviewed_at")
  reviewNotes  String?   @map("review_notes") @db.Text
  // Timestamps
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([ipAddress])
  @@index([deviceName])
  @@index([createdAt])
  @@index([markedSuspicious])
  @@map("login_activities")
  @@schema("apolo")
}

// ============================================
// SECURITY EVENT LOG
// ============================================

// Security event types for comprehensive audit trail
enum SecurityEventType {
  // Authentication events
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGIN_2FA_SUCCESS
  LOGIN_2FA_FAILED
  LOGOUT
  // Session events
  SESSION_CREATED
  SESSION_REVOKED
  SESSION_EXPIRED
  ALL_SESSIONS_REVOKED
  // Password events
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  PASSWORD_RESET_FAILED
  // 2FA events
  TWO_FACTOR_ENABLED
  TWO_FACTOR_DISABLED
  TWO_FACTOR_RECOVERY_USED
  TWO_FACTOR_RECOVERY_REGENERATED
  // Account events
  ACCOUNT_CREATED
  ACCOUNT_UPDATED
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED
  ACCOUNT_DELETED
  EMAIL_VERIFIED
  EMAIL_VERIFICATION_REQUESTED
  // Permission events
  ROLE_ASSIGNED
  ROLE_REMOVED
  PERMISSION_GRANTED
  PERMISSION_REVOKED
  ROLE_CREATED
  ROLE_UPDATED
  ROLE_DELETED
  // API key events
  API_KEY_CREATED
  API_KEY_ROTATED
  API_KEY_REVOKED
  API_KEY_DELETED
  // OAuth events
  OAUTH_ACCOUNT_LINKED
  OAUTH_ACCOUNT_UNLINKED
  OAUTH_LOGIN_SUCCESS
  OAUTH_LOGIN_FAILED
  // Security events
  SUSPICIOUS_LOGIN_DETECTED
  SUSPICIOUS_LOGIN_REVIEWED
  IP_BLOCKED
  IP_UNBLOCKED
  // Admin actions
  ADMIN_IMPERSONATION_START
  ADMIN_IMPERSONATION_END

  @@schema("apolo")
}

// Severity levels for security events
enum SecurityEventSeverity {
  INFO      // Routine events (login success, logout)
  WARNING   // Notable events (failed login, 2FA recovery used)
  CRITICAL  // Security-sensitive events (account locked, suspicious activity)

  @@schema("apolo")
}

model SecurityLog {
  id          String               @id @default(cuid())
  event       SecurityEventType
  severity    SecurityEventSeverity @default(INFO)
  // User context
  userId      String?              @map("user_id")
  userName    String?              @map("user_name")  // Preserved in case user is deleted
  userEmail   String?              @map("user_email") // For failed login attempts where userId may not exist
  // Target context (for permission/role changes affecting another user)
  targetUserId String?             @map("target_user_id")
  targetUserName String?           @map("target_user_name")
  // Request context
  ipAddress   String?              @map("ip_address")
  userAgent   String?              @map("user_agent") @db.Text
  // Location (optional, from IP geolocation)
  country     String?
  city        String?
  // Event details
  details     Json?                // Additional context (old/new values, error messages, etc.)
  sessionId   String?              @map("session_id")
  // Retention management
  expiresAt   DateTime             @map("expires_at") // For 90-day retention policy
  // Timestamps
  createdAt   DateTime             @default(now()) @map("created_at")

  @@index([userId])
  @@index([event])
  @@index([severity])
  @@index([ipAddress])
  @@index([createdAt])
  @@index([expiresAt])
  @@index([targetUserId])
  @@map("security_logs")
  @@schema("apolo")
}

// ============================================
// FLASH SALES
// ============================================

enum FlashSaleStatus {
  SCHEDULED   // Not yet started
  ACTIVE      // Currently running
  ENDED       // Completed
  CANCELLED   // Manually cancelled

  @@schema("apolo")
}

model FlashSale {
  id            String          @id @default(cuid())
  productId     String          @map("product_id")
  // Sale pricing
  salePriceUsd  Decimal         @map("sale_price_usd") @db.Decimal(10, 2)
  salePriceKhr  Int             @map("sale_price_khr")
  // Time window
  startTime     DateTime        @map("start_time")
  endTime       DateTime        @map("end_time")
  // Quantity limit (optional)
  quantity      Int?            // Max units available at flash price (null = unlimited)
  soldCount     Int             @default(0) @map("sold_count") // Units sold at flash price
  // Status and metadata
  status        FlashSaleStatus @default(SCHEDULED)
  nameEn        String?         @map("name_en") // Optional sale name for banners
  nameKh        String?         @map("name_kh")
  descriptionEn String?         @map("description_en") @db.Text
  descriptionKh String?         @map("description_kh") @db.Text
  // Featured on homepage banner
  isFeatured    Boolean         @default(false) @map("is_featured")
  bannerImageUrl String?        @map("banner_image_url")
  // Audit
  createdBy     String?         @map("created_by")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@index([productId])
  @@index([startTime])
  @@index([endTime])
  @@index([status])
  @@index([isFeatured])
  @@map("flash_sales")
  @@schema("apolo")
}

// ============================================
// LOYALTY PROGRAM
// ============================================

enum LoyaltyTier {
  BRONZE    // Base tier (1x multiplier)
  SILVER    // 500+ points earned (1.25x multiplier)
  GOLD      // 2000+ points earned (1.5x multiplier)
  PLATINUM  // 5000+ points earned (2x multiplier)

  @@schema("apolo")
}

enum LoyaltyTransactionType {
  EARN          // Points earned from purchase
  REDEEM        // Points redeemed for discount
  BONUS         // Bonus points (promotions, birthday, etc.)
  EXPIRE        // Points expired (12 months)
  ADJUSTMENT    // Manual admin adjustment
  REFUND        // Points refunded from cancelled order

  @@schema("apolo")
}

model LoyaltyAccount {
  id            String       @id @default(cuid())
  customerId    String       @unique @map("customer_id")
  // Points balance
  currentPoints Int          @default(0) @map("current_points") // Available points
  lifetimePoints Int         @default(0) @map("lifetime_points") // Total earned (for tier calculation)
  // Tier
  tier          LoyaltyTier  @default(BRONZE)
  tierUpdatedAt DateTime?    @map("tier_updated_at")
  // Timestamps
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  transactions  LoyaltyTransaction[]

  @@index([customerId])
  @@index([tier])
  @@map("loyalty_accounts")
  @@schema("apolo")
}

model LoyaltyTransaction {
  id            String                  @id @default(cuid())
  accountId     String                  @map("account_id")
  account       LoyaltyAccount          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type          LoyaltyTransactionType
  points        Int                     // Positive for earn/bonus, negative for redeem/expire
  // Reference to order (for EARN, REDEEM, REFUND)
  orderId       String?                 @map("order_id")
  // Description and metadata
  description   String?                 @db.Text
  metadata      Json?                   // Additional context (tier multiplier used, etc.)
  // Expiry tracking (for EARN/BONUS points)
  expiresAt     DateTime?               @map("expires_at") // Points expire 12 months after earning
  isExpired     Boolean                 @default(false) @map("is_expired")
  // Audit
  createdBy     String?                 @map("created_by") // Admin ID for manual adjustments
  createdAt     DateTime                @default(now()) @map("created_at")

  @@index([accountId])
  @@index([type])
  @@index([orderId])
  @@index([expiresAt])
  @@index([isExpired])
  @@index([createdAt])
  @@map("loyalty_transactions")
  @@schema("apolo")
}

// ============================================
// DEVELOPER BACKLOG (Dev Only)
// ============================================

enum BacklogPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@schema("apolo")
}

enum BacklogStatus {
  TODO
  IN_PROGRESS
  DONE

  @@schema("apolo")
}

model BacklogItem {
  id          String          @id @default(cuid())
  title       String
  description String?         @db.Text
  priority    BacklogPriority @default(MEDIUM)
  status      BacklogStatus   @default(TODO)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@index([status])
  @@index([priority])
  @@map("backlog_items")
  @@schema("apolo")
}
