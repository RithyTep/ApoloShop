// TikTok Business Account for TikTok Shop
model TikTokAccount {
  id              String   @id @default(cuid())
  // TikTok account info
  tiktokId        String   @unique @map("tiktok_id") // TikTok Business Account ID
  username        String   // @username
  displayName     String?  @map("display_name") // Display name
  avatarUrl       String?  @map("avatar_url") // Profile image URL
  bio             String?  @db.Text
  followersCount  Int      @default(0) @map("followers_count")
  followingCount  Int      @default(0) @map("following_count")
  likesCount      Int      @default(0) @map("likes_count")
  videoCount      Int      @default(0) @map("video_count")
  // OAuth tokens
  accessToken     String   @map("access_token") @db.Text
  tokenExpiresAt  DateTime? @map("token_expires_at")
  refreshToken    String?  @map("refresh_token") @db.Text
  // TikTok Shop info
