// Prisma Schema for ApoloShop CMS
// PostgreSQL database hosted on Neon (Vercel deployment)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["apolo"]
}

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String
  roleId       String    @map("role_id")
  role         Role      @relation(fields: [roleId], references: [id])
  isActive     Boolean   @default(true) @map("is_active")
  // Email verification fields
  emailVerified    Boolean   @default(false) @map("email_verified")
  emailVerifiedAt  DateTime? @map("email_verified_at")
  // Two-Factor Authentication (2FA) fields
  twoFactorEnabled Boolean   @default(false) @map("two_factor_enabled")
  twoFactorSecret  String?   @map("two_factor_secret") // Encrypted TOTP secret
  recoveryCodes    Json?     @map("recovery_codes") // Array of hashed recovery codes
  // Password security fields
  passwordChangedAt DateTime? @map("password_changed_at") // For password expiry reminders
  // Login notification preferences
  loginNotificationsEnabled Boolean @default(true) @map("login_notifications_enabled")
  // IP whitelisting for admin access
  allowedIPs   Json?     @map("allowed_ips") // Array of allowed IP addresses/CIDR ranges
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  sessions            Session[]
  passwordHistory     PasswordHistory[]
  socialAccounts      SocialAccount[]
  passwordResetTokens PasswordResetToken[]
  emailVerifyTokens   EmailVerifyToken[]
  blogPosts           BlogPost[]

  @@map("users")
  @@schema("apolo")
}

// System roles: super_admin, admin, manager, staff
model Role {
  id          String   @id @default(cuid())
  name        String   @unique // super_admin, admin, manager, staff
  displayName String   @default("") @map("display_name") // Human-readable name
  description String?  // Role description
  permissions Json     // Legacy: { "products": ["read", "write", "delete"], ... }
  isSystem    Boolean  @default(false) @map("is_system") // System roles cannot be deleted
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       User[]
  rolePermissions RolePermission[]

  @@map("roles")
  @@schema("apolo")
}

// Permission model for granular access control
model Permission {
  id          String   @id @default(cuid())
  name        String   @unique // e.g., "products:read", "orders:write"
  resource    String   // e.g., "products", "orders", "customers"
  action      String   // e.g., "read", "write", "delete"
  displayName String   @map("display_name") // Human-readable name
  description String?  // Permission description
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@index([resource])
  @@index([action])
  @@map("permissions")
  @@schema("apolo")
}

// Junction table for Role <-> Permission many-to-many
model RolePermission {
  id           String     @id @default(cuid())
  roleId       String     @map("role_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @map("created_at")

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
  @@schema("apolo")
}

model Session {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  // Device and location info
  deviceName   String?  @map("device_name") // e.g., "Chrome on Windows", "Mobile Safari on iPhone"
  deviceType   String?  @map("device_type") // "desktop", "mobile", "tablet"
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent") @db.Text
  location     String?  // Approximate location from IP (e.g., "Phnom Penh, KH")
  // Session timestamps
  lastActive   DateTime @default(now()) @map("last_active")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  // Session status
  isRevoked    Boolean  @default(false) @map("is_revoked")
  revokedAt    DateTime? @map("revoked_at")
  isCurrent    Boolean  @default(false) @map("is_current") // Marked true for current request's session

  @@index([userId])
  @@index([token])
  @@index([lastActive])
  @@index([isRevoked])
  @@map("sessions")
  @@schema("apolo")
}

// Password history for preventing password reuse
model PasswordHistory {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdAt])
  @@map("password_history")
  @@schema("apolo")
}

// Login attempts for brute force protection
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String   // Email attempted (may not correspond to existing user)
  userId    String?  @map("user_id") // Optional: linked user if email matches
  ipAddress String   @map("ip_address")
  userAgent String?  @map("user_agent") @db.Text
  success   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@index([ipAddress])
  @@index([createdAt])
  @@index([email, success, createdAt])
  @@map("login_attempts")
  @@schema("apolo")
}

// Account lockout tracking
model AccountLockout {
  id           String    @id @default(cuid())
  userId       String    @unique @map("user_id")
  lockedAt     DateTime  @default(now()) @map("locked_at")
  lockedUntil  DateTime  @map("locked_until")
  failedAttempts Int     @default(5) @map("failed_attempts")
  ipAddress    String?   @map("ip_address") // IP that triggered the lockout
  unlockedAt   DateTime? @map("unlocked_at") // Manual unlock timestamp
  unlockedBy   String?   @map("unlocked_by") // Admin who unlocked

  @@index([userId])
  @@index([lockedUntil])
  @@map("account_lockouts")
  @@schema("apolo")
}

// Password reset tokens
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique // Hashed token (SHA-256)
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at") // Null until token is used
  ipAddress String?  @map("ip_address") // IP that requested the reset
  userAgent String?  @map("user_agent") @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("password_reset_tokens")
  @@schema("apolo")
}

// Email verification tokens
model EmailVerifyToken {
  id         String    @id @default(cuid())
  userId     String?   @map("user_id")
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId String?   @map("customer_id")
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  email      String    // The email to verify (may differ from current email)
  token      String    @unique // Hashed token (SHA-256)
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at") // Null until token is used
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent") @db.Text
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([customerId])
  @@index([token])
  @@index([email])
  @@index([expiresAt])
  @@map("email_verify_tokens")
  @@schema("apolo")
}

// ============================================
// SOCIAL ACCOUNTS (OAuth)
// ============================================

enum OAuthProvider {
  GOOGLE
  FACEBOOK

  @@schema("apolo")
}

model SocialAccount {
  id              String        @id @default(cuid())
  userId          String?       @map("user_id") // Linked admin user (optional)
  user            User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId      String?       @map("customer_id") // Linked customer (optional)
  customer        Customer?     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  provider        OAuthProvider
  providerUserId  String        @map("provider_user_id") // ID from OAuth provider
  email           String?       // Email from OAuth provider
  name            String?       // Display name from OAuth provider
  avatarUrl       String?       @map("avatar_url")
  // Token storage (encrypted)
  accessToken     String?       @map("access_token") @db.Text
  refreshToken    String?       @map("refresh_token") @db.Text
  tokenExpiresAt  DateTime?     @map("token_expires_at")
  // Metadata
  rawProfile      Json?         @map("raw_profile") // Full profile data from provider
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@unique([provider, providerUserId]) // One account per provider per user
  @@index([userId])
  @@index([customerId])
  @@index([provider])
  @@index([email])
  @@map("social_accounts")
  @@schema("apolo")
}

// ============================================
// PRODUCT CATALOG
// ============================================

model Category {
  id        String    @id @default(cuid())
  nameEn    String    @map("name_en")
  nameKh    String    @map("name_kh")
  slug      String    @unique
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  products  Product[]

  @@map("categories")
  @@schema("apolo")
}

model Product {
  id            String    @id @default(cuid())
  clientId      String?   @map("client_id")
  client        Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  nameEn        String    @map("name_en")
  nameKh        String    @map("name_kh")
  slug          String?   @unique // SEO-friendly URL slug, auto-generated from nameEn
  descriptionEn String?   @map("description_en") @db.Text
  descriptionKh String?   @map("description_kh") @db.Text
  priceUsd      Decimal   @map("price_usd") @db.Decimal(10, 2)
  priceKhr      Int       @map("price_khr")
  categoryId    String    @map("category_id")
  category      Category  @relation(fields: [categoryId], references: [id])
  sku           String    @unique
  imageUrl      String?   @map("image_url")
  images        Json?     // Array of additional image URLs
  isActive      Boolean   @default(true) @map("is_active")
  // Variant configuration (defines which variant types this product supports)
  hasVariants   Boolean   @default(false) @map("has_variants")
  variantTypes  Json?     @map("variant_types") // Array of variant type names: ["size", "color", "material"]
  // Pre-order configuration
  isPreOrder         Boolean   @default(false) @map("is_pre_order")
  preOrderReleaseDate DateTime? @map("pre_order_release_date") // Date when product will be available
  preOrderDepositPercent Int?   @map("pre_order_deposit_percent") // % deposit required (null = full payment)
  preOrderMaxQuantity Int?      @map("pre_order_max_quantity") // Max quantity per pre-order (null = unlimited)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  inventory     Inventory?
  orderItems    OrderItem[]
  wishlists     Wishlist[]
  reviews       Review[]
  variants      ProductVariant[]
  productSubscriptions ProductSubscription[]
  stockNotifications   StockNotification[]
  questions     ProductQuestion[]
  blogPostProducts     BlogPostProduct[]
  instagramProducts    InstagramProduct[]
  facebookProducts     FacebookProduct[]
  tiktokProducts       TikTokProduct[]

  @@index([clientId])
  @@index([categoryId])
  @@index([sku])
  @@index([isActive])
  @@index([slug])
  @@index([isPreOrder])
  @@map("products")
  @@schema("apolo")
}

model Inventory {
  id           String    @id @default(cuid())
  productId    String    @unique @map("product_id")
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity     Int       @default(0)
  minLevel     Int       @default(10) @map("min_level")
  reorderPoint Int       @default(5) @map("reorder_point") // Point at which to trigger reorder alerts
  reorderQty   Int       @default(10) @map("reorder_qty") // Suggested reorder quantity (can be overridden by velocity calc)
  supplierId   String?   @map("supplier_id")
  supplier     Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  lastUpdated  DateTime  @default(now()) @map("last_updated")

  stockAlerts    StockAlert[]
  purchaseOrders PurchaseOrder[]

  @@index([supplierId])
  @@map("inventory")
  @@schema("apolo")
}

// Product variants for size, color, material, etc.
model ProductVariant {
  id          String   @id @default(cuid())
  productId   String   @map("product_id")
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku         String   @unique // Variant-specific SKU
  // Options for this variant (JSON object mapping type to value)
  // e.g., { "size": "M", "color": "Red" } or { "size": "L", "color": "Blue", "material": "Cotton" }
  options     Json     // { [optionType: string]: string }
  // Variant-specific pricing (if different from base product)
  priceUsd    Decimal? @map("price_usd") @db.Decimal(10, 2) // Null = use base product price
  priceKhr    Int?     @map("price_khr")
  // Variant-specific stock
  stock       Int      @default(0)
  // Variant-specific image (linked to options like color)
  imageUrl    String?  @map("image_url")
  // Display order
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  productSubscriptions ProductSubscription[]

  @@index([productId])
  @@index([sku])
  @@index([isActive])
  @@map("product_variants")
  @@schema("apolo")
}

// ============================================
// CUSTOMERS
// ============================================

model Customer {
  id        String   @id @default(cuid())
  clientId  String?  @map("client_id")
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  phone     String   @unique
  email     String?
  // Email verification fields
  emailVerified    Boolean   @default(false) @map("email_verified")
  emailVerifiedAt  DateTime? @map("email_verified_at")
  notes     String?  @db.Text
  tags      Json?    // ["VIP", "Frequent Buyer"]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orders                  Order[]
  wishlists               Wishlist[]
  reviews                 Review[]
  notificationPreferences NotificationPreference[]
  socialAccounts          SocialAccount[]
  emailVerifyTokens       EmailVerifyToken[]
  shippingAddresses       ShippingAddress[]
  segmentMemberships      CustomerSegmentMembership[]
  // Referral relations
  referralCode            ReferralCode?
  referralsMade           Referral[]  @relation("ReferrerCustomer")
  referralsReceived       Referral[]  @relation("RefereeCustomer")
  // Product subscriptions
  productSubscriptions    ProductSubscription[]
  // Product Q&A
  questions               ProductQuestion[]
  answers                 ProductAnswer[]
  // Facebook Messenger
  facebookConversations   FacebookConversation[]

  @@index([clientId])
  @@index([phone])
  @@map("customers")
  @@schema("apolo")
}

// Shipping Address for returning customers
model ShippingAddress {
  id          String    @id @default(cuid())
  customerId  String?   @map("customer_id")
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  guestId     String?   @map("guest_id") // For guest checkout
  label       String?   // "Home", "Work", etc.
  fullName    String    @map("full_name")
  phone       String
  province    String?   // Province/State
  district    String?   // District/City
  commune     String?   // Commune/Sangkat
  addressLine String    @map("address_line") @db.Text // Street address
  landmark    String?   // Nearby landmark
  isDefault   Boolean   @default(false) @map("is_default")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([guestId])
  @@index([isDefault])
  @@map("shipping_addresses")
  @@schema("apolo")
}

// ============================================
// ORDERS & PAYMENTS
// ============================================

enum OrderStatus {
  NEW
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED

  @@schema("apolo")
}

enum OrderChannel {
  WEBSITE
  TELEGRAM
  MESSENGER
  PHONE
  WALK_IN
  INSTAGRAM
  FACEBOOK
  TIKTOK

  @@schema("apolo")
}

enum Currency {
  USD
  KHR
  THB  // Thai Baht
  VND  // Vietnamese Dong
  SGD  // Singapore Dollar
  MYR  // Malaysian Ringgit
  EUR  // Euro
  GBP  // British Pound

  @@schema("apolo")
}

model Order {
  id          String       @id @default(cuid())
  clientId    String?      @map("client_id")
  client      Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  orderNumber String       @unique @map("order_number")
  customerId  String       @map("customer_id")
  customer    Customer     @relation(fields: [customerId], references: [id])
  status      OrderStatus  @default(NEW)
  totalUsd    Decimal      @map("total_usd") @db.Decimal(10, 2)
  totalKhr    Int          @map("total_khr")
  currency    Currency     @default(USD)
  channel     OrderChannel @default(WEBSITE)
  note        String?      @db.Text
  promotionId String?      @map("promotion_id")
  promotion   Promotion?   @relation(fields: [promotionId], references: [id])
  discountUsd Decimal?     @map("discount_usd") @db.Decimal(10, 2)
  discountKhr Int?         @map("discount_khr")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  items       OrderItem[]
  payments    Payment[]
  tracking    OrderTracking?
  referrals   Referral[]
  edits       OrderEdit[]
  shipments   Shipment[]
  instagramOrders InstagramOrder[]
  facebookOrders  FacebookOrder[]
  tiktokOrders    TikTokOrder[]
  influencerSale  InfluencerSale?

  // Order editing fields
  isEditable      Boolean   @default(true) @map("is_editable") // Can be edited before shipping
  editableUntil   DateTime? @map("editable_until") // Time window for editing
  shippingAddress Json?     @map("shipping_address") // Address snapshot for editing

  @@index([clientId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
  @@schema("apolo")
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String   @map("order_id")
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?  @map("product_id")
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String?  @map("product_name") // Preserved when product is deleted
  quantity    Int
  priceUsd    Decimal  @map("price_usd") @db.Decimal(10, 2)
  priceKhr    Int      @map("price_khr")
  // Order editing fields
  isCancelled Boolean  @default(false) @map("is_cancelled") // Individual item cancellation
  cancelledAt DateTime? @map("cancelled_at")

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
  @@schema("apolo")
}

enum PaymentMethod {
  CASH
  ABA_KHQR
  WING
  PAYWAY
  BANK_TRANSFER

  @@schema("apolo")
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED

  @@schema("apolo")
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String        @map("order_id")
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method        PaymentMethod
  amount        Decimal       @db.Decimal(10, 2)
  currency      Currency
  status        PaymentStatus @default(PENDING)
  transactionId String?       @map("transaction_id")
  metadata      Json?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([transactionId])
  @@map("payments")
  @@schema("apolo")
}

// ============================================
// PROMOTIONS
// ============================================

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT

  @@schema("apolo")
}

model Promotion {
  id        String        @id @default(cuid())
  code      String        @unique
  type      PromotionType
  value     Decimal       @db.Decimal(10, 2)
  minOrder  Decimal?      @map("min_order") @db.Decimal(10, 2)
  maxUses   Int?          @map("max_uses")
  usedCount Int           @default(0) @map("used_count")
  startDate DateTime      @map("start_date")
  endDate   DateTime      @map("end_date")
  isActive  Boolean       @default(true) @map("is_active")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  orders    Order[]

  @@index([code])
  @@index([isActive])
  @@map("promotions")
  @@schema("apolo")
}

// ============================================
// COUPONS & DISCOUNTS
// ============================================

enum CouponType {
  PERCENTAGE       // Percentage off total
  FIXED_AMOUNT     // Fixed dollar/riel amount off
  FREE_SHIPPING    // Free shipping discount
  BOGO             // Buy One Get One (applies to cheapest item)

  @@schema("apolo")
}

model Coupon {
  id            String     @id @default(cuid())
  code          String     @unique // Unique coupon code (uppercase)
  type          CouponType
  value         Decimal    @db.Decimal(10, 2) // Percentage (0-100) or fixed amount
  // Restrictions
  minOrderUsd   Decimal?   @map("min_order_usd") @db.Decimal(10, 2) // Minimum order value in USD
  maxDiscountUsd Decimal?  @map("max_discount_usd") @db.Decimal(10, 2) // Max discount cap for percentage coupons
  // Usage limits
  maxUses       Int?       @map("max_uses") // Total uses allowed (null = unlimited)
  maxUsesPerCustomer Int?  @map("max_uses_per_customer") // Uses per customer (null = unlimited)
  usedCount     Int        @default(0) @map("used_count") // Total times used
  // Validity period
  startsAt      DateTime   @map("starts_at")
  expiresAt     DateTime   @map("expires_at")
  // Status
  isActive      Boolean    @default(true) @map("is_active")
  // Optional: restrict to specific products/categories
  applicableProductIds Json? @map("applicable_product_ids") // Array of product IDs
  applicableCategoryIds Json? @map("applicable_category_ids") // Array of category IDs
  // Metadata
  description   String?    @db.Text // Internal description
  createdBy     String?    @map("created_by") // Admin who created
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  usages        CouponUsage[]

  @@index([code])
  @@index([isActive])
  @@index([expiresAt])
  @@map("coupons")
  @@schema("apolo")
}

// Track coupon usage per customer
model CouponUsage {
  id          String   @id @default(cuid())
  couponId    String   @map("coupon_id")
  coupon      Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  customerId  String?  @map("customer_id") // Null for guest checkouts
  guestId     String?  @map("guest_id") // For guest tracking
  orderId     String?  @map("order_id") // Link to the order
  discountUsd Decimal  @map("discount_usd") @db.Decimal(10, 2) // Actual discount applied
  discountKhr Int      @map("discount_khr")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([couponId])
  @@index([customerId])
  @@index([guestId])
  @@index([orderId])
  @@map("coupon_usages")
  @@schema("apolo")
}

// ============================================
// CMS CONTENT
// ============================================

enum ContentType {
  PAGE
  BLOG
  BANNER
  FAQ

  @@schema("apolo")
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@schema("apolo")
