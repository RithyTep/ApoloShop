// Prisma Schema for ApoloShop CMS
// PostgreSQL database hosted on Neon (Vercel deployment)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["apolo"]
}

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String
  roleId       String    @map("role_id")
  role         Role      @relation(fields: [roleId], references: [id])
  isActive     Boolean   @default(true) @map("is_active")
  // Two-Factor Authentication (2FA) fields
  twoFactorEnabled Boolean   @default(false) @map("two_factor_enabled")
  twoFactorSecret  String?   @map("two_factor_secret") // Encrypted TOTP secret
  recoveryCodes    Json?     @map("recovery_codes") // Array of hashed recovery codes
  // Password security fields
  passwordChangedAt DateTime? @map("password_changed_at") // For password expiry reminders
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  sessions         Session[]
  passwordHistory  PasswordHistory[]

  @@map("users")
  @@schema("apolo")
}

// System roles: super_admin, admin, manager, staff
model Role {
  id          String   @id @default(cuid())
  name        String   @unique // super_admin, admin, manager, staff
  displayName String   @default("") @map("display_name") // Human-readable name
  description String?  // Role description
  permissions Json     // Legacy: { "products": ["read", "write", "delete"], ... }
  isSystem    Boolean  @default(false) @map("is_system") // System roles cannot be deleted
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       User[]
  rolePermissions RolePermission[]

  @@map("roles")
  @@schema("apolo")
}

// Permission model for granular access control
model Permission {
  id          String   @id @default(cuid())
  name        String   @unique // e.g., "products:read", "orders:write"
  resource    String   // e.g., "products", "orders", "customers"
  action      String   // e.g., "read", "write", "delete"
  displayName String   @map("display_name") // Human-readable name
  description String?  // Permission description
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@index([resource])
  @@index([action])
  @@map("permissions")
  @@schema("apolo")
}

// Junction table for Role <-> Permission many-to-many
model RolePermission {
  id           String     @id @default(cuid())
  roleId       String     @map("role_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @map("created_at")

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
  @@schema("apolo")
}

model Session {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([token])
  @@map("sessions")
  @@schema("apolo")
}

// Password history for preventing password reuse
model PasswordHistory {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdAt])
  @@map("password_history")
  @@schema("apolo")
}

// Login attempts for brute force protection
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String   // Email attempted (may not correspond to existing user)
  userId    String?  @map("user_id") // Optional: linked user if email matches
  ipAddress String   @map("ip_address")
  userAgent String?  @map("user_agent") @db.Text
  success   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@index([ipAddress])
  @@index([createdAt])
  @@index([email, success, createdAt])
  @@map("login_attempts")
  @@schema("apolo")
}

// Account lockout tracking
model AccountLockout {
  id           String    @id @default(cuid())
  userId       String    @unique @map("user_id")
  lockedAt     DateTime  @default(now()) @map("locked_at")
  lockedUntil  DateTime  @map("locked_until")
  failedAttempts Int     @default(5) @map("failed_attempts")
  ipAddress    String?   @map("ip_address") // IP that triggered the lockout
  unlockedAt   DateTime? @map("unlocked_at") // Manual unlock timestamp
  unlockedBy   String?   @map("unlocked_by") // Admin who unlocked

  @@index([userId])
  @@index([lockedUntil])
  @@map("account_lockouts")
  @@schema("apolo")
}

// ============================================
// PRODUCT CATALOG
// ============================================

model Category {
  id        String    @id @default(cuid())
  nameEn    String    @map("name_en")
  nameKh    String    @map("name_kh")
  slug      String    @unique
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  products  Product[]

  @@map("categories")
  @@schema("apolo")
}

model Product {
  id            String    @id @default(cuid())
  clientId      String?   @map("client_id")
  client        Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  nameEn        String    @map("name_en")
  nameKh        String    @map("name_kh")
  descriptionEn String?   @map("description_en") @db.Text
  descriptionKh String?   @map("description_kh") @db.Text
  priceUsd      Decimal   @map("price_usd") @db.Decimal(10, 2)
  priceKhr      Int       @map("price_khr")
  categoryId    String    @map("category_id")
  category      Category  @relation(fields: [categoryId], references: [id])
  sku           String    @unique
  imageUrl      String?   @map("image_url")
  images        Json?     // Array of additional image URLs
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  inventory     Inventory?
  orderItems    OrderItem[]
  wishlists     Wishlist[]
  reviews       Review[]

  @@index([clientId])
  @@index([categoryId])
  @@index([sku])
  @@index([isActive])
  @@map("products")
  @@schema("apolo")
}

model Inventory {
  id          String   @id @default(cuid())
  productId   String   @unique @map("product_id")
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity    Int      @default(0)
  minLevel    Int      @default(10) @map("min_level")
  lastUpdated DateTime @default(now()) @map("last_updated")

  @@map("inventory")
  @@schema("apolo")
}

// ============================================
// CUSTOMERS
// ============================================

model Customer {
  id        String   @id @default(cuid())
  clientId  String?  @map("client_id")
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  phone     String   @unique
  email     String?
  notes     String?  @db.Text
  tags      Json?    // ["VIP", "Frequent Buyer"]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orders                  Order[]
  wishlists               Wishlist[]
  reviews                 Review[]
  notificationPreferences NotificationPreference[]

  @@index([clientId])
  @@index([phone])
  @@map("customers")
  @@schema("apolo")
}

// ============================================
// ORDERS & PAYMENTS
// ============================================

enum OrderStatus {
  NEW
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED

  @@schema("apolo")
}

enum OrderChannel {
  WEBSITE
  TELEGRAM
  MESSENGER
  PHONE
  WALK_IN

  @@schema("apolo")
}

enum Currency {
  USD
  KHR

  @@schema("apolo")
}

model Order {
  id          String       @id @default(cuid())
  clientId    String?      @map("client_id")
  client      Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  orderNumber String       @unique @map("order_number")
  customerId  String       @map("customer_id")
  customer    Customer     @relation(fields: [customerId], references: [id])
  status      OrderStatus  @default(NEW)
  totalUsd    Decimal      @map("total_usd") @db.Decimal(10, 2)
  totalKhr    Int          @map("total_khr")
  currency    Currency     @default(USD)
  channel     OrderChannel @default(WEBSITE)
  note        String?      @db.Text
  promotionId String?      @map("promotion_id")
  promotion   Promotion?   @relation(fields: [promotionId], references: [id])
  discountUsd Decimal?     @map("discount_usd") @db.Decimal(10, 2)
  discountKhr Int?         @map("discount_khr")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  items       OrderItem[]
  payments    Payment[]

  @@index([clientId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
  @@schema("apolo")
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String   @map("order_id")
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?  @map("product_id")
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String?  @map("product_name") // Preserved when product is deleted
  quantity    Int
  priceUsd    Decimal  @map("price_usd") @db.Decimal(10, 2)
  priceKhr    Int      @map("price_khr")

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
  @@schema("apolo")
}

enum PaymentMethod {
  CASH
  ABA_KHQR
  WING
  PAYWAY
  BANK_TRANSFER

  @@schema("apolo")
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED

  @@schema("apolo")
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String        @map("order_id")
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method        PaymentMethod
  amount        Decimal       @db.Decimal(10, 2)
  currency      Currency
  status        PaymentStatus @default(PENDING)
  transactionId String?       @map("transaction_id")
  metadata      Json?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([transactionId])
  @@map("payments")
  @@schema("apolo")
}

// ============================================
// PROMOTIONS
// ============================================

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT

  @@schema("apolo")
}

model Promotion {
  id        String        @id @default(cuid())
  code      String        @unique
  type      PromotionType
  value     Decimal       @db.Decimal(10, 2)
  minOrder  Decimal?      @map("min_order") @db.Decimal(10, 2)
  maxUses   Int?          @map("max_uses")
  usedCount Int           @default(0) @map("used_count")
  startDate DateTime      @map("start_date")
  endDate   DateTime      @map("end_date")
  isActive  Boolean       @default(true) @map("is_active")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  orders    Order[]

  @@index([code])
  @@index([isActive])
  @@map("promotions")
  @@schema("apolo")
}

// ============================================
// CMS CONTENT
// ============================================

enum ContentType {
  PAGE
  BLOG
  BANNER
  FAQ

  @@schema("apolo")
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@schema("apolo")
}

model CMSContent {
  id        String        @id @default(cuid())
  slug      String        @unique
  titleEn   String        @map("title_en")
  titleKh   String        @map("title_kh")
  contentEn String        @map("content_en") @db.Text
  contentKh String        @map("content_kh") @db.Text
  type      ContentType
  status    ContentStatus @default(DRAFT)
  metadata  Json?
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@index([type])
  @@index([status])
  @@map("cms_content")
  @@schema("apolo")
}

// ============================================
// SETTINGS
// ============================================

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
  @@schema("apolo")
}

// ============================================
// BUSINESS HOURS & HOLIDAYS
// ============================================

model BusinessHours {
  id        String   @id @default(cuid())
  dayOfWeek Int      @map("day_of_week") // 0=Sunday, 6=Saturday
  openTime  String?  @map("open_time")   // "09:00" or null if closed
  closeTime String?  @map("close_time")  // "22:00" or null if closed
  isOpen    Boolean  @default(true) @map("is_open")

  @@unique([dayOfWeek])
  @@map("business_hours")
  @@schema("apolo")
}

model Holiday {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  nameEn    String   @map("name_en")
  nameKh    String   @map("name_kh")
  isFullDay Boolean  @default(true) @map("is_full_day")
  openTime  String?  @map("open_time")
  closeTime String?  @map("close_time")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([date])
  @@map("holidays")
  @@schema("apolo")
}

// ============================================
// MULTI-TENANT CLIENT
// ============================================

model Client {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique // Used for subdomains: {slug}.apoloshop.com
  domain       String?  @unique // Custom domain: shop.example.com
  settings     Json?    // Client-specific settings (currency, language, etc.)
  // Theme fields for whitelabel branding
  primaryColor   String?  @map("primary_color")      // e.g., "oklch(0.72 0.16 356)"
  secondaryColor String?  @map("secondary_color")    // e.g., "oklch(0.65 0.15 250)"
  logoUrl        String?  @map("logo_url")           // URL to client's logo
  faviconUrl     String?  @map("favicon_url")        // URL to client's favicon
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  products     Product[]
  orders       Order[]
  customers    Customer[]
  customizations ShopCustomization[]
  subscription Subscription?

  @@index([slug])
  @@index([domain])
  @@index([isActive])
  @@map("clients")
  @@schema("apolo")
}

// ============================================
// SUBSCRIPTION & BILLING
// ============================================

enum SubscriptionPlan {
  FREE
  STARTER
  PRO

  @@schema("apolo")
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PAST_DUE

  @@schema("apolo")
}

model Subscription {
  id            String             @id @default(cuid())
  clientId      String             @unique @map("client_id")
  client        Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  plan          SubscriptionPlan   @default(FREE)
  status        SubscriptionStatus @default(ACTIVE)
  // Billing cycle
  currentPeriodStart DateTime      @map("current_period_start")
  currentPeriodEnd   DateTime      @map("current_period_end")
  // Usage tracking for limit enforcement
  productsUsed   Int               @default(0) @map("products_used")
  ordersThisMonth Int              @default(0) @map("orders_this_month")
  // External payment provider reference (for future integration)
  stripeCustomerId    String?      @map("stripe_customer_id")
  stripeSubscriptionId String?     @map("stripe_subscription_id")
  // Timestamps
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  cancelledAt   DateTime?          @map("cancelled_at")

  @@index([clientId])
  @@index([plan])
  @@index([status])
  @@map("subscriptions")
  @@schema("apolo")
}

// ============================================
// SHOP CUSTOMIZATION (White Label)
// ============================================

model ShopCustomization {
  id        String   @id @default(cuid())
  clientId  String?  @map("client_id")
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  version   Int      @default(1)
  isActive  Boolean  @default(true) @map("is_active")
  config    Json     // Full customization config (theme, sections, etc.)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([clientId])
  @@index([isActive])
  @@map("shop_customization")
  @@schema("apolo")
}

// ============================================
// SEARCH ANALYTICS
// ============================================

model SearchLog {
  id           String   @id @default(cuid())
  query        String
  resultsCount Int      @map("results_count")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([query])
  @@map("search_logs")
  @@schema("apolo")
}

// ============================================
// PRODUCT REVIEWS
// ============================================

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("apolo")
}

model Review {
  id         String       @id @default(cuid())
  productId  String       @map("product_id")
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String?      @map("customer_id")
  customer   Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  guestName  String?      @map("guest_name") // For guest reviews
  rating     Int          // 1-5 stars
  comment    String?      @db.Text
  status     ReviewStatus @default(PENDING)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  @@index([productId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("reviews")
  @@schema("apolo")
}

// ============================================
// WISHLIST
// ============================================

model Wishlist {
  id         String   @id @default(cuid())
  customerId String?  @map("customer_id")
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String   @map("product_id")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  guestId    String?  @map("guest_id") // For guest users (stored in localStorage)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([customerId, productId]) // One entry per customer-product pair
  @@unique([guestId, productId]) // One entry per guest-product pair
  @@index([customerId])
  @@index([guestId])
  @@index([productId])
  @@map("wishlists")
  @@schema("apolo")
}

// ============================================
// NOTIFICATION PREFERENCES
// ============================================

enum NotificationChannel {
  TELEGRAM
  EMAIL
  SMS

  @@schema("apolo")
}

model NotificationPreference {
  id           String   @id @default(cuid())
  customerId   String   @map("customer_id")
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  channel      NotificationChannel
  enabled      Boolean  @default(true)
  // Channel-specific identifiers
  telegramChatId String?  @map("telegram_chat_id")
  // Preferences for what to be notified about
  orderConfirmation Boolean @default(true) @map("order_confirmation")
  orderPreparing    Boolean @default(true) @map("order_preparing")
  orderReady        Boolean @default(true) @map("order_ready")
  orderCompleted    Boolean @default(true) @map("order_completed")
  orderCancelled    Boolean @default(true) @map("order_cancelled")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([customerId, channel])
  @@index([customerId])
  @@map("notification_preferences")
  @@schema("apolo")
}

model NotificationLog {
  id           String              @id @default(cuid())
  customerId   String              @map("customer_id")
  orderId      String?             @map("order_id")
  channel      NotificationChannel
  type         String              // e.g., "order_status_changed", "order_confirmed"
  message      String              @db.Text
  status       String              @default("sent") // "sent", "failed", "pending"
  errorMessage String?             @map("error_message") @db.Text
  sentAt       DateTime            @default(now()) @map("sent_at")

  @@index([customerId])
  @@index([orderId])
  @@index([sentAt])
  @@map("notification_logs")
  @@schema("apolo")
}

// ============================================
// AUDIT LOG
// ============================================

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  SETTINGS_CHANGE

  @@schema("apolo")
}

model AuditLog {
  id          String      @id @default(cuid())
  userId      String?     @map("user_id")
  userName    String?     @map("user_name") // Preserved in case user is deleted
  action      AuditAction
  resource    String      // e.g., "product", "order", "settings", "user"
  resourceId  String?     @map("resource_id")
  details     Json?       // Additional context (old/new values, etc.)
  ipAddress   String?     @map("ip_address")
  userAgent   String?     @map("user_agent") @db.Text
  createdAt   DateTime    @default(now()) @map("created_at")

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([resourceId])
  @@index([createdAt])
  @@map("audit_logs")
  @@schema("apolo")
}

// ============================================
// DEVELOPER BACKLOG (Dev Only)
// ============================================

enum BacklogPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@schema("apolo")
}

enum BacklogStatus {
  TODO
  IN_PROGRESS
  DONE

  @@schema("apolo")
}

model BacklogItem {
  id          String          @id @default(cuid())
  title       String
  description String?         @db.Text
  priority    BacklogPriority @default(MEDIUM)
  status      BacklogStatus   @default(TODO)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@index([status])
  @@index([priority])
  @@map("backlog_items")
  @@schema("apolo")
}
