  @@unique([customerId, channel])
  @@index([customerId])
  @@map("notification_preferences")
  @@schema("apolo")
}

model NotificationLog {
  id           String              @id @default(cuid())
  customerId   String              @map("customer_id")
  orderId      String?             @map("order_id")
  channel      NotificationChannel
  type         String              // e.g., "order_status_changed", "order_confirmed"
  message      String              @db.Text
  status       String              @default("sent") // "sent", "failed", "pending"
  errorMessage String?             @map("error_message") @db.Text
  sentAt       DateTime            @default(now()) @map("sent_at")

  @@index([customerId])
  @@index([orderId])
  @@index([sentAt])
  @@map("notification_logs")
  @@schema("apolo")
}

// ============================================
// AUDIT LOG
// ============================================

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  SETTINGS_CHANGE

  @@schema("apolo")
}

model AuditLog {
  id          String      @id @default(cuid())
  userId      String?     @map("user_id")
  userName    String?     @map("user_name") // Preserved in case user is deleted
  action      AuditAction
  resource    String      // e.g., "product", "order", "settings", "user"
  resourceId  String?     @map("resource_id")
  details     Json?       // Additional context (old/new values, etc.)
  ipAddress   String?     @map("ip_address")
  userAgent   String?     @map("user_agent") @db.Text
  createdAt   DateTime    @default(now()) @map("created_at")

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([resourceId])
  @@index([createdAt])
  @@map("audit_logs")
  @@schema("apolo")
}

// ============================================
// API KEYS FOR THIRD-PARTY INTEGRATIONS
// ============================================

model ApiKey {
  id           String    @id @default(cuid())
  clientId     String?   @map("client_id")
  name         String    // Human-readable name for the key
  keyHash      String    @unique @map("key_hash") // SHA-256 hash of the API key
  keyPrefix    String    @map("key_prefix") // First 8 chars for identification (ak_XXXXXXXX...)
  scopes       Json      // Array of scopes: ["read:products", "write:orders", etc.]
  // Rate limiting
  rateLimitPerMinute Int @default(60) @map("rate_limit_per_minute")
  // Usage tracking
  lastUsedAt   DateTime? @map("last_used_at")
  usageCount   Int       @default(0) @map("usage_count")
  // Key rotation
  previousKeyHash String? @map("previous_key_hash") // For key rotation without downtime
  previousKeyExpiresAt DateTime? @map("previous_key_expires_at")
  // Status
  isActive     Boolean   @default(true) @map("is_active")
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  // Metadata
  description  String?   @db.Text
  createdBy    String?   @map("created_by") // User ID who created the key

  @@index([clientId])
  @@index([keyHash])
  @@index([keyPrefix])
  @@index([isActive])
  @@map("api_keys")
  @@schema("apolo")
}

// API Key usage log for rate limiting and analytics
model ApiKeyUsageLog {
  id        String   @id @default(cuid())
  apiKeyId  String   @map("api_key_id")
  endpoint  String   // The endpoint that was accessed
  method    String   // HTTP method
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent") @db.Text
  statusCode Int?    @map("status_code")
  responseTime Int?  @map("response_time") // In milliseconds
  createdAt DateTime @default(now()) @map("created_at")

  @@index([apiKeyId])
  @@index([createdAt])
  @@index([apiKeyId, createdAt])
  @@map("api_key_usage_logs")
  @@schema("apolo")
}

// ============================================
// LOGIN ACTIVITY & SECURITY
// ============================================

// Login activity for tracking and notifying users of new logins
model LoginActivity {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  sessionId    String?  @map("session_id") // Reference to the session created
  // Device information
  deviceName   String?  @map("device_name") // e.g., "Chrome on Windows"
  deviceType   String?  @map("device_type") // "desktop", "mobile", "tablet"
  browser      String?  // Browser name
  os           String?  // Operating system
  // Location information
  ipAddress    String   @map("ip_address")
  country      String?  // Country from IP geolocation
  city         String?  // City from IP geolocation
  region       String?  // Region/state from IP geolocation
  // Tracking
  isNewDevice  Boolean  @default(false) @map("is_new_device")
  isNewLocation Boolean @default(false) @map("is_new_location")
  notificationSent Boolean @default(false) @map("notification_sent")
  // Security review
  markedSuspicious Boolean @default(false) @map("marked_suspicious")
  suspiciousAt DateTime? @map("suspicious_at")
  reviewedAt   DateTime? @map("reviewed_at")
  reviewNotes  String?   @map("review_notes") @db.Text
  // Timestamps
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([ipAddress])
  @@index([deviceName])
  @@index([createdAt])
  @@index([markedSuspicious])
  @@map("login_activities")
  @@schema("apolo")
}

// ============================================
// SECURITY EVENT LOG
// ============================================

// Security event types for comprehensive audit trail
enum SecurityEventType {
  // Authentication events
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGIN_2FA_SUCCESS
  LOGIN_2FA_FAILED
  LOGOUT
  // Session events
  SESSION_CREATED
  SESSION_REVOKED
  SESSION_EXPIRED
  ALL_SESSIONS_REVOKED
  // Password events
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  PASSWORD_RESET_FAILED
  // 2FA events
  TWO_FACTOR_ENABLED
  TWO_FACTOR_DISABLED
  TWO_FACTOR_RECOVERY_USED
  TWO_FACTOR_RECOVERY_REGENERATED
  // Account events
  ACCOUNT_CREATED
  ACCOUNT_UPDATED
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED
  ACCOUNT_DELETED
  EMAIL_VERIFIED
  EMAIL_VERIFICATION_REQUESTED
  // Permission events
  ROLE_ASSIGNED
  ROLE_REMOVED
  PERMISSION_GRANTED
  PERMISSION_REVOKED
  ROLE_CREATED
  ROLE_UPDATED
  ROLE_DELETED
  // API key events
  API_KEY_CREATED
  API_KEY_ROTATED
  API_KEY_REVOKED
  API_KEY_DELETED
  // OAuth events
  OAUTH_ACCOUNT_LINKED
  OAUTH_ACCOUNT_UNLINKED
  OAUTH_LOGIN_SUCCESS
  OAUTH_LOGIN_FAILED
  // Security events
  SUSPICIOUS_LOGIN_DETECTED
  SUSPICIOUS_LOGIN_REVIEWED
  IP_BLOCKED
  IP_UNBLOCKED
  // Admin actions
  ADMIN_IMPERSONATION_START
  ADMIN_IMPERSONATION_END

  @@schema("apolo")
}

// Severity levels for security events
enum SecurityEventSeverity {
  INFO      // Routine events (login success, logout)
  WARNING   // Notable events (failed login, 2FA recovery used)
  CRITICAL  // Security-sensitive events (account locked, suspicious activity)

  @@schema("apolo")
}

model SecurityLog {
  id          String               @id @default(cuid())
  event       SecurityEventType
  severity    SecurityEventSeverity @default(INFO)
  // User context
  userId      String?              @map("user_id")
  userName    String?              @map("user_name")  // Preserved in case user is deleted
  userEmail   String?              @map("user_email") // For failed login attempts where userId may not exist
  // Target context (for permission/role changes affecting another user)
  targetUserId String?             @map("target_user_id")
  targetUserName String?           @map("target_user_name")
  // Request context
  ipAddress   String?              @map("ip_address")
  userAgent   String?              @map("user_agent") @db.Text
  // Location (optional, from IP geolocation)
  country     String?
  city        String?
  // Event details
  details     Json?                // Additional context (old/new values, error messages, etc.)
  sessionId   String?              @map("session_id")
  // Retention management
  expiresAt   DateTime             @map("expires_at") // For 90-day retention policy
  // Timestamps
  createdAt   DateTime             @default(now()) @map("created_at")

  @@index([userId])
  @@index([event])
  @@index([severity])
  @@index([ipAddress])
  @@index([createdAt])
  @@index([expiresAt])
  @@index([targetUserId])
  @@map("security_logs")
  @@schema("apolo")
}

// ============================================
// FLASH SALES
// ============================================

enum FlashSaleStatus {
  SCHEDULED   // Not yet started
  ACTIVE      // Currently running
  ENDED       // Completed
  CANCELLED   // Manually cancelled

  @@schema("apolo")
}

model FlashSale {
  id            String          @id @default(cuid())
  productId     String          @map("product_id")
  // Sale pricing
  salePriceUsd  Decimal         @map("sale_price_usd") @db.Decimal(10, 2)
  salePriceKhr  Int             @map("sale_price_khr")
  // Time window
  startTime     DateTime        @map("start_time")
  endTime       DateTime        @map("end_time")
  // Quantity limit (optional)
  quantity      Int?            // Max units available at flash price (null = unlimited)
  soldCount     Int             @default(0) @map("sold_count") // Units sold at flash price
  // Status and metadata
  status        FlashSaleStatus @default(SCHEDULED)
  nameEn        String?         @map("name_en") // Optional sale name for banners
  nameKh        String?         @map("name_kh")
  descriptionEn String?         @map("description_en") @db.Text
  descriptionKh String?         @map("description_kh") @db.Text
  // Featured on homepage banner
  isFeatured    Boolean         @default(false) @map("is_featured")
  bannerImageUrl String?        @map("banner_image_url")
  // Audit
  createdBy     String?         @map("created_by")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@index([productId])
  @@index([startTime])
  @@index([endTime])
  @@index([status])
  @@index([isFeatured])
  @@map("flash_sales")
  @@schema("apolo")
}

// ============================================
// PRODUCT BUNDLES
// ============================================

enum BundleDiscountType {
  PERCENTAGE  // Percentage off total bundle price
  FIXED       // Fixed amount off total bundle price

  @@schema("apolo")
}

model Bundle {
  id            String             @id @default(cuid())
  clientId      String?            @map("client_id")
  client        Client?            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  nameEn        String             @map("name_en")
  nameKh        String             @map("name_kh")
  slug          String?            @unique // SEO-friendly URL slug
  descriptionEn String?            @map("description_en") @db.Text
  descriptionKh String?            @map("description_kh") @db.Text
  imageUrl      String?            @map("image_url")
  // Discount configuration
  discountType  BundleDiscountType @default(PERCENTAGE) @map("discount_type")
  discountValue Decimal            @map("discount_value") @db.Decimal(10, 2) // Percentage (0-100) or fixed amount in USD
  // Status
  isActive      Boolean            @default(true) @map("is_active")
  // Featured/promoted
  isFeatured    Boolean            @default(false) @map("is_featured")
  // Stock management - bundle is available if all products have stock
  // Optional: limit bundle purchases
  maxPurchases  Int?               @map("max_purchases") // Max times bundle can be purchased (null = unlimited)
  purchaseCount Int                @default(0) @map("purchase_count") // Times this bundle has been purchased
  // Timestamps
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  items         BundleItem[]

  @@index([clientId])
  @@index([isActive])
  @@index([isFeatured])
  @@index([slug])
  @@map("bundles")
  @@schema("apolo")
}

model BundleItem {
  id        String  @id @default(cuid())
  bundleId  String  @map("bundle_id")
  bundle    Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  productId String  @map("product_id")
  quantity  Int     @default(1) // How many of this product in the bundle
  // Optional: override individual item pricing (usually null, uses product price)
  // Sort order for display
  sortOrder Int     @default(0) @map("sort_order")

  @@unique([bundleId, productId])
  @@index([bundleId])
  @@index([productId])
  @@map("bundle_items")
  @@schema("apolo")
}

// ============================================
// LOYALTY PROGRAM
// ============================================

enum LoyaltyTier {
  BRONZE    // Base tier (1x multiplier)
  SILVER    // 500+ points earned (1.25x multiplier)
  GOLD      // 2000+ points earned (1.5x multiplier)
  PLATINUM  // 5000+ points earned (2x multiplier)

  @@schema("apolo")
}

enum LoyaltyTransactionType {
  EARN          // Points earned from purchase
  REDEEM        // Points redeemed for discount
  BONUS         // Bonus points (promotions, birthday, etc.)
  EXPIRE        // Points expired (12 months)
  ADJUSTMENT    // Manual admin adjustment
  REFUND        // Points refunded from cancelled order

  @@schema("apolo")
}

model LoyaltyAccount {
  id            String       @id @default(cuid())
  customerId    String       @unique @map("customer_id")
  // Points balance
  currentPoints Int          @default(0) @map("current_points") // Available points
  lifetimePoints Int         @default(0) @map("lifetime_points") // Total earned (for tier calculation)
  // Tier
  tier          LoyaltyTier  @default(BRONZE)
  tierUpdatedAt DateTime?    @map("tier_updated_at")
  // Timestamps
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  transactions  LoyaltyTransaction[]

  @@index([customerId])
  @@index([tier])
  @@map("loyalty_accounts")
  @@schema("apolo")
}

model LoyaltyTransaction {
  id            String                  @id @default(cuid())
  accountId     String                  @map("account_id")
  account       LoyaltyAccount          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type          LoyaltyTransactionType
  points        Int                     // Positive for earn/bonus, negative for redeem/expire
  // Reference to order (for EARN, REDEEM, REFUND)
  orderId       String?                 @map("order_id")
  // Description and metadata
  description   String?                 @db.Text
  metadata      Json?                   // Additional context (tier multiplier used, etc.)
  // Expiry tracking (for EARN/BONUS points)
  expiresAt     DateTime?               @map("expires_at") // Points expire 12 months after earning
  isExpired     Boolean                 @default(false) @map("is_expired")
  // Audit
  createdBy     String?                 @map("created_by") // Admin ID for manual adjustments
  createdAt     DateTime                @default(now()) @map("created_at")

  @@index([accountId])
  @@index([type])
  @@index([orderId])
  @@index([expiresAt])
  @@index([isExpired])
  @@index([createdAt])
  @@map("loyalty_transactions")
  @@schema("apolo")
}

