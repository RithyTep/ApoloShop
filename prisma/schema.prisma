// ============================================
// EMAIL MARKETING
// ============================================

// Newsletter subscription status
enum SubscriptionStatusType {
  ACTIVE        // Subscribed and receiving emails
  UNSUBSCRIBED  // User unsubscribed
  BOUNCED       // Email bounced
  COMPLAINED    // User marked as spam

  @@schema("apolo")
}

model NewsletterSubscriber {
  id           String                @id @default(cuid())
  email        String                @unique
  name         String?               // Optional subscriber name
  customerId   String?               @map("customer_id") // Link to customer if known
  status       SubscriptionStatusType @default(ACTIVE)
  source       String?               // Where they subscribed: "footer", "popup", "checkout"
  // Preferences
  language     String                @default("en") // Preferred language
  // Tracking
  confirmedAt  DateTime?             @map("confirmed_at") // Double opt-in confirmation
  unsubscribedAt DateTime?           @map("unsubscribed_at")
  unsubscribeToken String            @unique @map("unsubscribe_token") // For one-click unsubscribe
  // Metadata
  ipAddress    String?               @map("ip_address")
  userAgent    String?               @map("user_agent") @db.Text
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  @@index([email])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("newsletter_subscribers")
  @@schema("apolo")
}

// Email campaign types
enum EmailCampaignType {
  NEWSLETTER       // Regular newsletter
  PROMOTIONAL      // Sales/promotions
  TRANSACTIONAL    // Order confirmations, shipping
  WELCOME          // Welcome series
  ABANDONED_CART   // Cart recovery
  WINBACK          // Re-engagement

  @@schema("apolo")
}

enum EmailCampaignStatus {
  DRAFT        // Being edited
  SCHEDULED    // Scheduled for future
  SENDING      // Currently sending
  SENT         // Completed
  CANCELLED    // Cancelled before completion

  @@schema("apolo")
}

model EmailCampaign {
  id            String              @id @default(cuid())
  name          String              // Internal name
  type          EmailCampaignType
  status        EmailCampaignStatus @default(DRAFT)
  // Content
  subjectEn     String              @map("subject_en")
  subjectKh     String?             @map("subject_kh")
  bodyHtmlEn    String              @map("body_html_en") @db.Text
  bodyHtmlKh    String?             @map("body_html_kh") @db.Text
  bodyTextEn    String?             @map("body_text_en") @db.Text // Plain text version
  bodyTextKh    String?             @map("body_text_kh") @db.Text
  // Targeting
  segmentFilter Json?               @map("segment_filter") // e.g., {"tags": ["VIP"], "minOrders": 3}
  // Scheduling
  scheduledAt   DateTime?           @map("scheduled_at")
  sentAt        DateTime?           @map("sent_at")
  // Statistics
  totalSent     Int                 @default(0) @map("total_sent")
  totalOpened   Int                 @default(0) @map("total_opened")
  totalClicked  Int                 @default(0) @map("total_clicked")
  totalBounced  Int                 @default(0) @map("total_bounced")
  totalUnsubscribed Int             @default(0) @map("total_unsubscribed")
  // Metadata
  createdBy     String?             @map("created_by")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  sends         EmailSend[]

  @@index([type])
  @@index([status])
  @@index([scheduledAt])
  @@index([createdAt])
  @@map("email_campaigns")
  @@schema("apolo")
}

// Track individual email sends
enum EmailSendStatus {
  PENDING      // Queued for sending
  SENT         // Successfully sent
  DELIVERED    // Confirmed delivery
  OPENED       // Email opened
  CLICKED      // Link clicked
  BOUNCED      // Email bounced
  FAILED       // Send failed
  UNSUBSCRIBED // User unsubscribed from this email

  @@schema("apolo")
}

model EmailSend {
  id            String          @id @default(cuid())
  campaignId    String?         @map("campaign_id")
  campaign      EmailCampaign?  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  subscriberId  String?         @map("subscriber_id")
  email         String          // Recipient email
  customerId    String?         @map("customer_id")
  // Email metadata
  emailType     EmailCampaignType // Even for non-campaign emails
  subject       String
  // Status tracking
  status        EmailSendStatus @default(PENDING)
  sentAt        DateTime?       @map("sent_at")
  deliveredAt   DateTime?       @map("delivered_at")
  openedAt      DateTime?       @map("opened_at")
  clickedAt     DateTime?       @map("clicked_at")
  // Error handling
  errorMessage  String?         @map("error_message") @db.Text
  retryCount    Int             @default(0) @map("retry_count")
  // Tracking
  trackingId    String          @unique @map("tracking_id") // UUID for tracking opens/clicks
  // Provider info
  providerMessageId String?     @map("provider_message_id") // SendGrid/Mailchimp message ID
  // Timestamps
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@index([campaignId])
  @@index([subscriberId])
  @@index([email])
  @@index([customerId])
  @@index([emailType])
  @@index([status])
  @@index([trackingId])
  @@index([createdAt])
  @@map("email_sends")
  @@schema("apolo")
}

// Abandoned cart tracking for recovery emails
enum AbandonedCartStatus {
  ACTIVE           // Cart is still active (recently updated)
  ABANDONED        // Cart is abandoned (no activity)
  RECOVERED        // User completed purchase
  EMAIL_1_SENT     // First recovery email sent (1hr)
  EMAIL_2_SENT     // Second recovery email sent (24hr)
  EMAIL_3_SENT     // Third recovery email sent (72hr)
  UNRECOVERABLE    // Max emails sent, no conversion

  @@schema("apolo")
}

model AbandonedCart {
  id            String              @id @default(cuid())
  // Customer identification
  customerId    String?             @map("customer_id")
  guestId       String?             @map("guest_id")
  email         String?             // Email for recovery (may be collected at checkout)
  // Cart contents (snapshot)
  cartItems     Json                @map("cart_items") // Array of {productId, name, quantity, price, imageUrl}
  cartTotal     Decimal             @map("cart_total") @db.Decimal(10, 2)
  currency      Currency            @default(USD)
  // Tracking
  status        AbandonedCartStatus @default(ACTIVE)
  lastActivityAt DateTime           @map("last_activity_at")
  abandonedAt   DateTime?           @map("abandoned_at") // When cart was marked as abandoned
  recoveredAt   DateTime?           @map("recovered_at") // When user completed purchase
  orderId       String?             @map("order_id") // Link to order if recovered
  // Email tracking
  email1SentAt  DateTime?           @map("email_1_sent_at")
  email2SentAt  DateTime?           @map("email_2_sent_at")
  email3SentAt  DateTime?           @map("email_3_sent_at")
  // Recovery token for cart restoration
  recoveryToken String              @unique @map("recovery_token")
  // Metadata
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([guestId])
  @@index([email])
  @@index([status])
  @@index([lastActivityAt])
  @@index([recoveryToken])
  @@map("abandoned_carts")
  @@schema("apolo")
}

// Welcome email series tracking
model WelcomeEmailProgress {
  id            String   @id @default(cuid())
  customerId    String?  @map("customer_id")
  subscriberId  String?  @map("subscriber_id")
  email         String   @unique
  // Progress
  email1SentAt  DateTime? @map("email_1_sent_at") // Immediate welcome
  email2SentAt  DateTime? @map("email_2_sent_at") // 1 day later - tips/features
  email3SentAt  DateTime? @map("email_3_sent_at") // 3 days later - first purchase incentive
  completedAt   DateTime? @map("completed_at")
  // Tracking
  firstOrderAt  DateTime? @map("first_order_at") // When they made first purchase
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([subscriberId])
  @@index([email])
  @@map("welcome_email_progress")
  @@schema("apolo")
}

// ============================================
// PERFORMANCE MONITORING
// ============================================

enum MetricType {
  WEB_VITAL      // Core Web Vitals (LCP, FID, CLS, FCP, TTFB)
  API_RESPONSE   // API endpoint response times
  DATABASE_QUERY // Database query performance
  ERROR          // Error tracking

  @@schema("apolo")
}

model PerformanceMetric {
  id          String     @id @default(cuid())
  type        MetricType
  name        String     // Metric name (e.g., "LCP", "FID", "/api/products", "findMany")
  value       Float      // Metric value in milliseconds
  // Rating for Core Web Vitals
  rating      String?    // "good", "needs-improvement", "poor"
  // Context
  path        String?    // Page path or API endpoint
  method      String?    // HTTP method for API metrics
  // User/Session info
  sessionId   String?    @map("session_id")
  userId      String?    @map("user_id")
  // Device info
  deviceType  String?    @map("device_type") // "mobile", "desktop", "tablet"
  userAgent   String?    @map("user_agent") @db.Text
  // Additional details
  details     Json?      // Additional context (error stack, query details, etc.)
  // Timestamps
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([type])
  @@index([name])
  @@index([rating])
  @@index([path])
  @@index([createdAt])
  @@index([type, createdAt])
  @@map("performance_metrics")
  @@schema("apolo")
}

// Error log for Sentry-like error tracking
model ErrorLog {
  id          String   @id @default(cuid())
  // Error info
  message     String   @db.Text
  stack       String?  @db.Text
  name        String?  // Error name/type
  // Context
  path        String?  // Page or API path
  method      String?  // HTTP method for API errors
  statusCode  Int?     @map("status_code")
  // User/Session info
  sessionId   String?  @map("session_id")
  userId      String?  @map("user_id")
  // Request info
  requestBody Json?    @map("request_body")
  requestHeaders Json? @map("request_headers")
  // Device info
  deviceType  String?  @map("device_type")
  userAgent   String?  @map("user_agent") @db.Text
  ipAddress   String?  @map("ip_address")
  // Fingerprint for grouping similar errors
  fingerprint String?
  // Resolution
  resolved    Boolean  @default(false)
  resolvedAt  DateTime? @map("resolved_at")
  resolvedBy  String?  @map("resolved_by")
  // Timestamps
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([fingerprint])
  @@index([path])
  @@index([resolved])
  @@index([createdAt])
  @@map("error_logs")
  @@schema("apolo")
}

// ============================================
// LIVE CHAT SUPPORT
// ============================================

enum ChatSessionStatus {
  ACTIVE       // Chat is active (customer or agent online)
  WAITING      // Waiting for agent response
  RESOLVED     // Chat resolved/closed
  OFFLINE      // Offline message submitted

  @@schema("apolo")
}

enum ChatMessageSender {
  CUSTOMER     // Message from customer
  AGENT        // Message from support agent
  SYSTEM       // System message (e.g., "Agent joined")

  @@schema("apolo")
}

model ChatSession {
  id            String            @id @default(cuid())
  // Customer identification
  customerId    String?           @map("customer_id")
  guestId       String?           @map("guest_id") // For non-logged-in visitors
  customerName  String?           @map("customer_name")
  customerEmail String?           @map("customer_email")
  // Agent assignment
  agentId       String?           @map("agent_id") // User ID of assigned agent
  agentName     String?           @map("agent_name")
  // Status
  status        ChatSessionStatus @default(ACTIVE)
  // Metadata
  subject       String?           // Optional subject/topic
  pageUrl       String?           @map("page_url") // Page where chat was started
  userAgent     String?           @map("user_agent") @db.Text
  ipAddress     String?           @map("ip_address")
  // Timestamps
  lastActivityAt DateTime         @default(now()) @map("last_activity_at")
  resolvedAt    DateTime?         @map("resolved_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  messages      ChatMessage[]

  @@index([customerId])
  @@index([guestId])
  @@index([agentId])
  @@index([status])
  @@index([lastActivityAt])
  @@index([createdAt])
  @@map("chat_sessions")
  @@schema("apolo")
}

model ChatMessage {
  id          String            @id @default(cuid())
  sessionId   String            @map("session_id")
  session     ChatSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  // Sender info
  sender      ChatMessageSender
  senderId    String?           @map("sender_id") // User ID for agents, customer/guest ID for customers
  senderName  String?           @map("sender_name")
  // Content
  content     String            @db.Text
  // Read status
  isRead      Boolean           @default(false) @map("is_read")
  readAt      DateTime?         @map("read_at")
  // Timestamps
  createdAt   DateTime          @default(now()) @map("created_at")

  @@index([sessionId])
  @@index([sender])
  @@index([isRead])
  @@index([createdAt])
  @@map("chat_messages")
  @@schema("apolo")
}

// Canned responses for quick replies
model CannedResponse {
  id          String   @id @default(cuid())
  title       String   // Short title for selection
  contentEn   String   @map("content_en") @db.Text // English response
  contentKh   String?  @map("content_kh") @db.Text // Khmer response
  category    String?  // Category for organization (e.g., "Shipping", "Returns")
  shortcut    String?  @unique // Keyboard shortcut (e.g., "/hello", "/thanks")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@index([shortcut])
  @@index([isActive])
  @@map("canned_responses")
  @@schema("apolo")
}

// Agent online status tracking
model AgentStatus {
  id          String   @id @default(cuid())
  userId      String   @unique @map("user_id") // Admin user ID
  isOnline    Boolean  @default(false) @map("is_online")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isOnline])
  @@index([lastSeenAt])
  @@map("agent_statuses")
  @@schema("apolo")
}

// ============================================
// SHIPPING ZONES
// ============================================

enum ShippingRateType {
  FLAT_RATE        // Fixed price per order
  WEIGHT_BASED     // Price based on weight
  FREE             // Free shipping

  @@schema("apolo")
}

model ShippingZone {
  id            String           @id @default(cuid())
  nameEn        String           @map("name_en")
  nameKh        String           @map("name_kh")
  // Regions covered (JSON array of province/district codes)
  regions       Json             // e.g., ["PP", "BTB", "SR"] for provinces
  // Rate configuration
  rateType      ShippingRateType @default(FLAT_RATE) @map("rate_type")
  flatRateUsd   Decimal?         @map("flat_rate_usd") @db.Decimal(10, 2)
  flatRateKhr   Int?             @map("flat_rate_khr")
  // Weight-based pricing (per kg)
  pricePerKgUsd Decimal?         @map("price_per_kg_usd") @db.Decimal(10, 2)
  pricePerKgKhr Int?             @map("price_per_kg_khr")
  baseWeightKg  Decimal?         @map("base_weight_kg") @db.Decimal(10, 2) // Free weight up to
  // Free shipping threshold
  freeThresholdUsd Decimal?      @map("free_threshold_usd") @db.Decimal(10, 2) // Free shipping over this amount
  freeThresholdKhr Int?          @map("free_threshold_khr")
  // Estimated delivery time
  minDeliveryDays Int?           @map("min_delivery_days")
  maxDeliveryDays Int?           @map("max_delivery_days")
  // Status
  isActive      Boolean          @default(true) @map("is_active")
  sortOrder     Int              @default(0) @map("sort_order")
  // Timestamps
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  @@index([isActive])
  @@index([sortOrder])
  @@map("shipping_zones")
  @@schema("apolo")
}

// ============================================
// ORDER TRACKING
// ============================================

// Courier/shipping provider
enum CourierProvider {
  JT_EXPRESS        // J&T Express Cambodia
  NINJA_VAN         // Ninja Van Cambodia
  WING_DELIVERY     // Wing delivery service
  OTHER             // Custom/other provider

  @@schema("apolo")
}

// Tracking status for shipments
enum TrackingStatus {
  PENDING           // Waiting to be picked up
  PICKED_UP         // Picked up from sender
  IN_TRANSIT        // In transit to destination
  OUT_FOR_DELIVERY  // Out for delivery
  DELIVERED         // Successfully delivered
  FAILED_DELIVERY   // Delivery attempt failed
  RETURNED          // Returned to sender

  @@schema("apolo")
}

model OrderTracking {
  id              String          @id @default(cuid())
  orderId         String          @unique @map("order_id")
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Tracking information
  trackingNumber  String?         @map("tracking_number")
  courier         CourierProvider @default(OTHER)
  courierName     String?         @map("courier_name") // Custom name if OTHER
  // Current status
  status          TrackingStatus  @default(PENDING)
  // Estimated delivery
  estimatedDeliveryDate DateTime? @map("estimated_delivery_date")
  actualDeliveryDate    DateTime? @map("actual_delivery_date")
  // Shipping address (snapshot)
  shippingAddress Json?           @map("shipping_address")
  // Customer notification preferences
  notifyOnStatusChange Boolean    @default(true) @map("notify_on_status_change")
  notifyViaTelegram    Boolean    @default(true) @map("notify_via_telegram")
  notifyViaSms         Boolean    @default(false) @map("notify_via_sms")
  // Timestamps
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  // Status history
  statusHistory   TrackingStatusHistory[]

  @@index([orderId])
  @@index([trackingNumber])
  @@index([status])
  @@index([courier])
  @@map("order_tracking")
  @@schema("apolo")
}

model TrackingStatusHistory {
  id              String         @id @default(cuid())
  trackingId      String         @map("tracking_id")
  tracking        OrderTracking  @relation(fields: [trackingId], references: [id], onDelete: Cascade)
  status          TrackingStatus
  location        String?        // Location/hub where status changed
  notes           String?        @db.Text
  notificationSent Boolean       @default(false) @map("notification_sent")
  createdAt       DateTime       @default(now()) @map("created_at")

  @@index([trackingId])
  @@index([status])
  @@index([createdAt])
  @@map("tracking_status_history")
  @@schema("apolo")
}

// ============================================
// HELP CENTER / FAQ
// ============================================

enum HelpArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@schema("apolo")
}

model HelpCategory {
  id          String   @id @default(cuid())
  nameEn      String   @map("name_en")
  nameKh      String   @map("name_kh")
  slug        String   @unique
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  iconName    String?  @map("icon_name") // Lucide icon name
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  articles    HelpArticle[]

  @@index([slug])
  @@index([isActive])
  @@index([sortOrder])
  @@map("help_categories")
  @@schema("apolo")
}

model HelpArticle {
  id            String            @id @default(cuid())
  categoryId    String            @map("category_id")
  category      HelpCategory      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  titleEn       String            @map("title_en")
  titleKh       String            @map("title_kh")
  slug          String            @unique
  contentEn     String            @map("content_en") @db.Text
  contentKh     String            @map("content_kh") @db.Text
  // SEO
  metaTitleEn   String?           @map("meta_title_en")
  metaTitleKh   String?           @map("meta_title_kh")
  metaDescEn    String?           @map("meta_desc_en") @db.Text
  metaDescKh    String?           @map("meta_desc_kh") @db.Text
  // Status and visibility
  status        HelpArticleStatus @default(DRAFT)
  sortOrder     Int               @default(0) @map("sort_order")
  isFeatured    Boolean           @default(false) @map("is_featured") // Show on help center home
  // Analytics
  viewCount     Int               @default(0) @map("view_count")
  helpfulYes    Int               @default(0) @map("helpful_yes")
  helpfulNo     Int               @default(0) @map("helpful_no")
  // Timestamps
  publishedAt   DateTime?         @map("published_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  @@index([categoryId])
  @@index([slug])
  @@index([status])
  @@index([isFeatured])
  @@index([viewCount])
  @@index([sortOrder])
  @@map("help_articles")
  @@schema("apolo")
}

// ============================================
// SUPPLIERS & STOCK ALERTS
// ============================================

model Supplier {
  id          String   @id @default(cuid())
  name        String
  contactName String?  @map("contact_name")
  email       String?
  phone       String?
  address     String?  @db.Text
  website     String?
  notes       String?  @db.Text
  leadTimeDays Int     @default(7) @map("lead_time_days") // Average days to receive order
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  inventory      Inventory[]
  purchaseOrders PurchaseOrder[]

  @@index([name])
  @@index([isActive])
  @@map("suppliers")
  @@schema("apolo")
}

enum StockAlertType {
  LOW_STOCK       // Stock at or below reorder point
  OUT_OF_STOCK    // Stock is zero
  REORDER_CREATED // Purchase order created

  @@schema("apolo")
}

enum StockAlertStatus {
  PENDING    // Alert not yet addressed
  ACKNOWLEDGED  // Admin has seen it
  RESOLVED   // Stock has been replenished

  @@schema("apolo")
}

model StockAlert {
  id          String           @id @default(cuid())
  inventoryId String           @map("inventory_id")
  inventory   Inventory        @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  type        StockAlertType
  status      StockAlertStatus @default(PENDING)
  quantity    Int              // Stock level when alert was triggered
  reorderPoint Int             @map("reorder_point") // Reorder point when alert was triggered
  suggestedQty Int             @map("suggested_qty") // Suggested reorder quantity based on sales velocity
  notifiedAt  DateTime?        @map("notified_at") // When notification was sent
  resolvedAt  DateTime?        @map("resolved_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  @@index([inventoryId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("stock_alerts")
  @@schema("apolo")
}

enum PurchaseOrderStatus {
  DRAFT      // Not yet sent to supplier
  PENDING    // Sent to supplier, awaiting delivery
  PARTIAL    // Partially received
  COMPLETED  // Fully received
  CANCELLED  // Order cancelled

  @@schema("apolo")
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  orderNumber  String              @unique @map("order_number") // e.g., PO-2025-0001
  inventoryId  String              @map("inventory_id")
  inventory    Inventory           @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  supplierId   String?             @map("supplier_id")
  supplier     Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  quantity     Int                 // Quantity ordered
  unitCostUsd  Decimal?            @map("unit_cost_usd") @db.Decimal(10, 2)
  totalCostUsd Decimal?            @map("total_cost_usd") @db.Decimal(10, 2)
  status       PurchaseOrderStatus @default(DRAFT)
  notes        String?             @db.Text
  expectedDate DateTime?           @map("expected_date") // Expected delivery date
  receivedQty  Int                 @default(0) @map("received_qty") // Quantity received so far
  receivedAt   DateTime?           @map("received_at")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  @@index([inventoryId])
  @@index([supplierId])
  @@index([status])
  @@index([orderNumber])
  @@index([createdAt])
  @@map("purchase_orders")
  @@schema("apolo")
}

// ============================================
// POS INTEGRATION
// ============================================

enum POSProviderType {
  SQUARE
  LOYVERSE

  @@schema("apolo")
}

enum POSSyncStatus {
  PENDING     // Sync scheduled but not started
  IN_PROGRESS // Currently syncing
  COMPLETED   // Sync finished successfully
  FAILED      // Sync failed with error

  @@schema("apolo")
}

enum POSSyncDirection {
  INBOUND   // From POS to ApoloShop (sales import, inventory update)
  OUTBOUND  // From ApoloShop to POS (product update)
  BIDIRECTIONAL // Both directions

  @@schema("apolo")
}

model POSProvider {
  id                String          @id @default(cuid())
  clientId          String?         @map("client_id")
  client            Client?         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name              String          // Display name, e.g., "Main Store Square"
  type              POSProviderType
  // API Credentials (encrypted)
  accessToken       String?         @map("access_token") // Encrypted OAuth token
  refreshToken      String?         @map("refresh_token") // Encrypted refresh token
  tokenExpiresAt    DateTime?       @map("token_expires_at")
  // Provider-specific IDs
  locationId        String?         @map("location_id") // Square location ID or Loyverse store ID
  merchantId        String?         @map("merchant_id") // Provider merchant/account ID
  // Sync settings
  syncInventory     Boolean         @default(true) @map("sync_inventory") // Auto-sync inventory changes
  syncSales         Boolean         @default(true) @map("sync_sales") // Import sales from POS
  syncCustomers     Boolean         @default(true) @map("sync_customers") // Sync customer data
  syncInterval      Int             @default(15) @map("sync_interval") // Minutes between auto-syncs
  lastSyncAt        DateTime?       @map("last_sync_at")
  // Status
  isActive          Boolean         @default(true) @map("is_active")
  connectionStatus  String          @default("disconnected") @map("connection_status") // connected, disconnected, error
  lastError         String?         @map("last_error") @db.Text
  // Webhook
  webhookSecret     String?         @map("webhook_secret") // For verifying webhook payloads
  webhookUrl        String?         @map("webhook_url") // Auto-generated webhook URL for this provider
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  syncs            POSSync[]
  sales            POSSale[]
  productMappings  POSProductMapping[]
  customerMappings POSCustomerMapping[]

  @@index([clientId])
  @@index([type])
  @@index([isActive])
  @@map("pos_providers")
  @@schema("apolo")
}

model POSSync {
  id           String           @id @default(cuid())
  providerId   String           @map("provider_id")
  provider     POSProvider      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  direction    POSSyncDirection
  status       POSSyncStatus    @default(PENDING)
  // Sync scope
  syncType     String           @map("sync_type") // "inventory", "sales", "customers", "products", "full"
  // Progress tracking
  totalItems   Int              @default(0) @map("total_items")
  processedItems Int            @default(0) @map("processed_items")
  failedItems  Int              @default(0) @map("failed_items")
  // Timing
  startedAt    DateTime?        @map("started_at")
  completedAt  DateTime?        @map("completed_at")
  // Results
  summary      Json?            // { created: 5, updated: 10, failed: 1, errors: [...] }
  errorDetails String?          @map("error_details") @db.Text
  // Metadata
  triggeredBy  String?          @map("triggered_by") // "manual", "scheduled", "webhook"
  createdAt    DateTime         @default(now()) @map("created_at")

  @@index([providerId])
  @@index([status])
  @@index([syncType])
  @@index([createdAt])
  @@map("pos_syncs")
  @@schema("apolo")
}

model POSSale {
  id             String      @id @default(cuid())
  providerId     String      @map("provider_id")
  provider       POSProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  // POS reference
  posTransactionId String    @unique @map("pos_transaction_id") // Original transaction ID from POS
  posReceiptNumber String?   @map("pos_receipt_number")
  // Sale details
  totalAmount    Decimal     @map("total_amount") @db.Decimal(10, 2)
  currency       Currency    @default(USD)
  taxAmount      Decimal?    @map("tax_amount") @db.Decimal(10, 2)
  discountAmount Decimal?    @map("discount_amount") @db.Decimal(10, 2)
  // Payment info
  paymentMethod  String?     @map("payment_method") // "cash", "card", "mobile", etc.
  paymentStatus  String      @default("completed") @map("payment_status")
  // Customer (if identified)
  customerId     String?     @map("customer_id") // Mapped ApoloShop customer
  posCustomerId  String?     @map("pos_customer_id") // Original POS customer ID
  // Items (denormalized for quick access)
  items          Json        // Array of { productId, posItemId, name, quantity, price, discount }
  itemCount      Int         @default(0) @map("item_count")
  // Timestamps
  saleDate       DateTime    @map("sale_date") // When sale occurred in POS
  importedAt     DateTime    @default(now()) @map("imported_at")
  // Link to ApoloShop order (if created)
  orderId        String?     @map("order_id")
  createdAt      DateTime    @default(now()) @map("created_at")

  @@index([providerId])
  @@index([posTransactionId])
  @@index([customerId])
  @@index([saleDate])
  @@index([orderId])
  @@map("pos_sales")
  @@schema("apolo")
}

model POSProductMapping {
  id           String      @id @default(cuid())
  providerId   String      @map("provider_id")
  provider     POSProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  productId    String      @map("product_id")
  posItemId    String      @map("pos_item_id") // Product ID in POS system
  posVariationId String?   @map("pos_variation_id") // Variant ID in POS (for Square)
  posSku       String?     @map("pos_sku") // SKU in POS system
  // Sync settings per product
  syncInventory Boolean    @default(true) @map("sync_inventory")
  syncPrice    Boolean     @default(false) @map("sync_price") // Whether to sync price changes
  lastSyncAt   DateTime?   @map("last_sync_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@unique([providerId, productId])
  @@unique([providerId, posItemId])
  @@index([productId])
  @@index([posItemId])
  @@map("pos_product_mappings")
  @@schema("apolo")
}

model POSCustomerMapping {
  id            String      @id @default(cuid())
  providerId    String      @map("provider_id")
  provider      POSProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  customerId    String      @map("customer_id")
  posCustomerId String      @map("pos_customer_id") // Customer ID in POS system
  lastSyncAt    DateTime?   @map("last_sync_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@unique([providerId, customerId])
  @@unique([providerId, posCustomerId])
  @@index([customerId])
  @@index([posCustomerId])
  @@map("pos_customer_mappings")
  @@schema("apolo")
}

// ============================================
// WEBHOOK INTEGRATIONS
// ============================================

enum WebhookEvent {
  ORDER_CREATED
  ORDER_UPDATED
  PRODUCT_UPDATED
  CUSTOMER_CREATED

  @@schema("apolo")
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
  RETRYING

  @@schema("apolo")
}

model Webhook {
  id          String         @id @default(cuid())
  clientId    String?        @map("client_id")
  client      Client?        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name        String         // User-friendly name for the webhook
  url         String         // Target URL for webhook delivery
  events      WebhookEvent[] // Array of events this webhook subscribes to
  secret      String         // Secret key for HMAC signature verification
  isActive    Boolean        @default(true) @map("is_active")
  // Metadata
  description String?
  headers     Json?          // Custom headers to include in requests
  // Stats
  lastTriggeredAt DateTime?  @map("last_triggered_at")
  successCount    Int        @default(0) @map("success_count")
  failureCount    Int        @default(0) @map("failure_count")
  // Timestamps
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  deliveryLogs WebhookDeliveryLog[]

  @@index([clientId])
  @@index([isActive])
  @@map("webhooks")
  @@schema("apolo")
}

model WebhookDeliveryLog {
  id           String                @id @default(cuid())
  webhookId    String                @map("webhook_id")
  webhook      Webhook               @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event        WebhookEvent          // The event that triggered this delivery
  payload      Json                  // The payload sent to the webhook URL
  // Delivery details
  status       WebhookDeliveryStatus @default(PENDING)
  httpStatus   Int?                  @map("http_status") // Response status code
  response     String?               // Response body (truncated if too long)
  errorMessage String?               @map("error_message")
  // Retry information
  attempt      Int                   @default(1) // Current attempt number
  maxAttempts  Int                   @default(3) @map("max_attempts")
  nextRetryAt  DateTime?             @map("next_retry_at")
  // Timing
  sentAt       DateTime?             @map("sent_at")
  completedAt  DateTime?             @map("completed_at")
  durationMs   Int?                  @map("duration_ms") // How long the request took
  // Signature for verification
  signature    String?               // The HMAC signature sent
  createdAt    DateTime              @default(now()) @map("created_at")

  @@index([webhookId])
  @@index([status])
  @@index([event])
  @@index([createdAt])
  @@map("webhook_delivery_logs")
  @@schema("apolo")
}

// ============================================
// GIFT CARDS
// ============================================

enum GiftCardStatus {
  ACTIVE     // Card can be used
  REDEEMED   // Fully redeemed (zero balance)
  EXPIRED    // Past expiration date
  CANCELLED  // Manually cancelled by admin

  @@schema("apolo")
}

model GiftCard {
  id              String          @id @default(cuid())
  code            String          @unique // 16-char code like XXXX-XXXX-XXXX-XXXX
  initialBalance  Decimal         @map("initial_balance") @db.Decimal(10, 2) // Original purchased amount
  currentBalance  Decimal         @map("current_balance") @db.Decimal(10, 2) // Remaining balance
  currency        Currency        @default(USD)
  status          GiftCardStatus  @default(ACTIVE)
  // Purchaser info
  purchaserId     String?         @map("purchaser_id") // Customer who bought the card (null for admin-created)
  purchaserEmail  String?         @map("purchaser_email")
  // Recipient info
  recipientEmail  String          @map("recipient_email")
  recipientName   String?         @map("recipient_name")
  personalMessage String?         @map("personal_message") @db.Text // Gift message
  // Delivery tracking
  emailSentAt     DateTime?       @map("email_sent_at") // When gift card email was sent
  // Validity
  expiresAt       DateTime?       @map("expires_at") // Optional expiration date
  // Metadata
  createdBy       String?         @map("created_by") // Admin user ID if admin-created
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  transactions    GiftCardTransaction[]

  @@index([code])
  @@index([status])
  @@index([recipientEmail])
  @@index([purchaserId])
  @@index([expiresAt])
  @@map("gift_cards")
  @@schema("apolo")
}

// Track gift card usage
model GiftCardTransaction {
  id           String    @id @default(cuid())
  giftCardId   String    @map("gift_card_id")
  giftCard     GiftCard  @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  type         String    // "purchase" | "redemption" | "refund" | "admin_adjustment"
  amount       Decimal   @db.Decimal(10, 2) // Positive for credit, negative for debit
  balanceAfter Decimal   @map("balance_after") @db.Decimal(10, 2) // Balance after transaction
  orderId      String?   @map("order_id") // Associated order if redemption
  note         String?   @db.Text // Admin notes or description
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([giftCardId])
  @@index([orderId])
  @@index([createdAt])
  @@map("gift_card_transactions")
  @@schema("apolo")
}

// ============================================
// CUSTOMER SEGMENTATION
// ============================================

enum SegmentType {
  AUTO      // System-generated based on RFM
  CUSTOM    // Admin-created with filter rules

  @@schema("apolo")
}

model CustomerSegment {
  id          String      @id @default(cuid())
  name        String      // Segment name: "VIP", "At Risk", "New", etc.
  nameKh      String?     @map("name_kh") // Khmer translation
  description String?     @db.Text
  type        SegmentType @default(AUTO)
  // RFM thresholds for AUTO segments
  rfmConfig   Json?       @map("rfm_config") // { recencyDays, frequencyMin, monetaryMin }
  // Custom filter rules for CUSTOM segments
  filterRules Json?       @map("filter_rules") // Array of { field, operator, value }
  // Visual styling
  color       String      @default("#3b82f6") // Badge color for UI
  icon        String?     // Optional icon name
  // Segment stats (cached, updated periodically)
  customerCount Int       @default(0) @map("customer_count")
  totalRevenue  Decimal   @default(0) @map("total_revenue") @db.Decimal(12, 2)
  lastCalculatedAt DateTime? @map("last_calculated_at")
  // Management
  isActive    Boolean     @default(true) @map("is_active")
  sortOrder   Int         @default(0) @map("sort_order")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  memberships CustomerSegmentMembership[]

  @@unique([name])
  @@index([type])
  @@index([isActive])
  @@index([sortOrder])
  @@map("customer_segments")
  @@schema("apolo")
}

// Junction table for customer-segment membership with RFM scores
model CustomerSegmentMembership {
  id           String          @id @default(cuid())
  customerId   String          @map("customer_id")
  customer     Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  segmentId    String          @map("segment_id")
  segment      CustomerSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  // RFM scores at time of assignment
  recencyScore   Int?          @map("recency_score")   // 1-5 scale
  frequencyScore Int?          @map("frequency_score") // 1-5 scale
  monetaryScore  Int?          @map("monetary_score")  // 1-5 scale
  rfmTotal       Int?          @map("rfm_total")       // Sum of R+F+M (3-15)
  // Additional metrics
  lastOrderDays  Int?          @map("last_order_days") // Days since last order
  totalOrders    Int?          @map("total_orders")    // Lifetime order count
  totalSpent     Decimal?      @map("total_spent") @db.Decimal(12, 2) // Lifetime spend
  // Membership tracking
  assignedAt   DateTime        @default(now()) @map("assigned_at")
  assignedBy   String?         @map("assigned_by") // "system" or admin user ID
  expiresAt    DateTime?       @map("expires_at")  // For time-limited memberships

  @@unique([customerId, segmentId])
  @@index([customerId])
  @@index([segmentId])
  @@index([rfmTotal])
  @@index([assignedAt])
  @@map("customer_segment_memberships")
  @@schema("apolo")
}

// ============================================
// A/B TESTING FRAMEWORK
// ============================================

enum ExperimentStatus {
  DRAFT     // Being configured, not yet running
  RUNNING   // Actively collecting data
  PAUSED    // Temporarily stopped
  COMPLETED // Ended (manual or auto-end)

  @@schema("apolo")
}

enum ExperimentType {
  PRODUCT_PAGE    // Test different product page layouts
  CHECKOUT        // Test checkout flow variations
  PRICING         // Test different prices
  HOMEPAGE        // Test homepage variations
  PROMOTION       // Test promotional banners/offers
  CUSTOM          // Custom experiment type

  @@schema("apolo")
}

model Experiment {
  id               String           @id @default(cuid())
  name             String           // Experiment name
  description      String?          @db.Text
  type             ExperimentType   @default(CUSTOM)
  status           ExperimentStatus @default(DRAFT)
  // Traffic configuration
  trafficPercent   Int              @default(100) @map("traffic_percent") // % of total traffic included (1-100)
  // Goal tracking
  goalType         String           @default("conversion") @map("goal_type") // "conversion", "revenue", "clicks", "add_to_cart"
  goalDescription  String?          @map("goal_description")
  // Statistical settings
  confidenceLevel  Int              @default(95) @map("confidence_level") // 90, 95, or 99
  minSampleSize    Int              @default(100) @map("min_sample_size") // Min visitors per variant
  // Auto-end configuration
  autoEndEnabled   Boolean          @default(true) @map("auto_end_enabled")
  autoEndOnSignificance Boolean     @default(true) @map("auto_end_on_significance")
  // Timing
  startedAt        DateTime?        @map("started_at")
  endedAt          DateTime?        @map("ended_at")
  scheduledStartAt DateTime?        @map("scheduled_start_at")
  scheduledEndAt   DateTime?        @map("scheduled_end_at")
  // Results cache
  winningVariantId String?          @map("winning_variant_id")
  isSignificant    Boolean          @default(false) @map("is_significant")
  // Metadata
  createdBy        String?          @map("created_by")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  variants         ExperimentVariant[]

  @@index([status])
  @@index([type])
  @@index([startedAt])
  @@index([endedAt])
  @@map("experiments")
  @@schema("apolo")
}

model ExperimentVariant {
  id              String     @id @default(cuid())
  experimentId    String     @map("experiment_id")
  experiment      Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  name            String     // "Control", "Variant A", "Variant B", etc.
  description     String?    @db.Text
  isControl       Boolean    @default(false) @map("is_control") // True for control variant
  // Traffic split (must sum to 100 across all variants)
  trafficWeight   Int        @default(50) @map("traffic_weight") // Weight for random assignment
  // Variant configuration (JSON for flexibility)
  config          Json?      // { priceMultiplier: 1.1 } or { layoutId: "v2" } etc.
  // Metrics (updated in real-time or batch)
  visitors        Int        @default(0) // Total unique visitors assigned
  conversions     Int        @default(0) // Conversions (based on experiment goal)
  revenue         Decimal    @default(0) @db.Decimal(12, 2) // Total revenue for revenue goals
  // Calculated metrics (updated periodically)
  conversionRate  Decimal    @default(0) @map("conversion_rate") @db.Decimal(5, 4) // e.g., 0.0523 = 5.23%
  avgOrderValue   Decimal    @default(0) @map("avg_order_value") @db.Decimal(10, 2)
  // Timestamps
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  assignments     ExperimentAssignment[]

  @@index([experimentId])
  @@index([isControl])
  @@map("experiment_variants")
  @@schema("apolo")
}

// Track which variant each visitor was assigned to
model ExperimentAssignment {
  id             String            @id @default(cuid())
  variantId      String            @map("variant_id")
  variant        ExperimentVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  // Visitor identification (anonymous or customer)
  visitorId      String            @map("visitor_id") // Browser fingerprint or cookie ID
  customerId     String?           @map("customer_id") // Linked customer if logged in
  // Conversion tracking
  converted      Boolean           @default(false)
  convertedAt    DateTime?         @map("converted_at")
  conversionValue Decimal?         @map("conversion_value") @db.Decimal(10, 2) // Order value if revenue goal
  orderId        String?           @map("order_id") // Associated order if applicable
  // Metadata
  ipAddress      String?           @map("ip_address")
  userAgent      String?           @map("user_agent") @db.Text
  createdAt      DateTime          @default(now()) @map("created_at")

  @@unique([variantId, visitorId])
  @@index([variantId])
  @@index([visitorId])
  @@index([customerId])
  @@index([converted])
  @@index([createdAt])
  @@map("experiment_assignments")
  @@schema("apolo")
}

// ============================================
// STORE LOCATOR
// ============================================

model StoreLocation {
  id          String   @id @default(cuid())
  name        String   // Store name in English
  nameKh      String?  @map("name_kh") // Store name in Khmer
  address     String   @db.Text // Full address
  addressKh   String?  @map("address_kh") @db.Text // Address in Khmer
  // Geolocation
  lat         Decimal  @db.Decimal(10, 8) // Latitude (-90 to 90)
  lng         Decimal  @db.Decimal(11, 8) // Longitude (-180 to 180)
  // Contact info
  phone       String?  // Phone number for click-to-call
  email       String?  // Store email
  // Operating hours (JSON for flexibility)
  // Format: { "monday": { "open": "09:00", "close": "18:00" }, "tuesday": { "open": "09:00", "close": "18:00" }, ... }
  hours       Json?    // Operating hours per day
  hoursNote   String?  @map("hours_note") // Additional note (e.g., "Closed on public holidays")
  hoursNoteKh String?  @map("hours_note_kh") // Khmer translation
  // Additional info
  description String?  @db.Text // Store description
  descriptionKh String? @map("description_kh") @db.Text
  imageUrl    String?  @map("image_url") // Store photo
  // Status
  isActive    Boolean  @default(true) @map("is_active")
  isPrimary   Boolean  @default(false) @map("is_primary") // Mark main/flagship store
  sortOrder   Int      @default(0) @map("sort_order")
  // Timestamps
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@index([isPrimary])
  @@index([sortOrder])
  @@index([lat, lng])
  @@map("store_locations")
  @@schema("apolo")
}

// ============================================
// REFERRAL PROGRAM
// ============================================

enum ReferralStatus {
  PENDING    // Referral code used but no qualifying purchase yet
  COMPLETED  // Referee made first purchase, rewards credited
  EXPIRED    // Referral expired before completion
  CANCELLED  // Referral cancelled

  @@schema("apolo")
}

model Referral {
  id              String         @id @default(cuid())
  // Referrer (the person who referred)
  referrerId      String         @map("referrer_id")
  referrer        Customer       @relation("ReferrerCustomer", fields: [referrerId], references: [id], onDelete: Cascade)
  // Referee (the person who was referred)
  refereeId       String?        @map("referee_id")
  referee         Customer?      @relation("RefereeCustomer", fields: [refereeId], references: [id], onDelete: SetNull)
  // Referral code used
  code            String         // The referral code that was used
  // Status tracking
  status          ReferralStatus @default(PENDING)
  // Rewards
  referrerReward  Decimal        @default(0) @map("referrer_reward") @db.Decimal(12, 2) // Amount credited to referrer
  refereeReward   Decimal        @default(0) @map("referee_reward") @db.Decimal(12, 2)  // Amount credited to referee
  rewardType      String         @default("FIXED") @map("reward_type") // FIXED or PERCENTAGE
  // First order that triggered completion
  orderId         String?        @map("order_id")
  order           Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  // Timestamps
  completedAt     DateTime?      @map("completed_at")
  expiresAt       DateTime?      @map("expires_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@index([referrerId])
  @@index([refereeId])
  @@index([code])
  @@index([status])
  @@index([createdAt])
  @@map("referrals")
  @@schema("apolo")
}

// Referral code management for each customer
model ReferralCode {
  id           String   @id @default(cuid())
  customerId   String   @unique @map("customer_id")
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  code         String   @unique // Unique referral code (e.g., "FRIEND-ABC123")
  // Statistics
  timesUsed    Int      @default(0) @map("times_used")
  totalEarned  Decimal  @default(0) @map("total_earned") @db.Decimal(12, 2)
  // Configuration
  isActive     Boolean  @default(true) @map("is_active")
  // Timestamps
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([code])
  @@index([isActive])
  @@map("referral_codes")
  @@schema("apolo")
}

// ============================================
// SOCIAL PROOF
// ============================================

// Social proof configuration for the shop
model SocialProofConfig {
  id                      String   @id @default(cuid())
  // Recent purchase notifications
  showRecentPurchases     Boolean  @default(true) @map("show_recent_purchases")
  purchaseDisplayDelay    Int      @default(5) @map("purchase_display_delay") // Seconds between notifications
  purchaseDisplayDuration Int      @default(5) @map("purchase_display_duration") // Seconds to show each notification
  purchaseTimeWindow      Int      @default(24) @map("purchase_time_window") // Hours to look back for purchases
  // Currently viewing count
  showViewerCount         Boolean  @default(true) @map("show_viewer_count")
  viewerCountMin          Int      @default(5) @map("viewer_count_min") // Minimum simulated viewers
  viewerCountMax          Int      @default(20) @map("viewer_count_max") // Maximum simulated viewers
  // Items sold counter
  showSoldCount           Boolean  @default(true) @map("show_sold_count")
  // Trust badges
  showTrustBadges         Boolean  @default(true) @map("show_trust_badges")
  enabledBadges           Json     @default("[\"secure\", \"guarantee\", \"shipping\"]") @map("enabled_badges") // Array of badge IDs
  // Display position
  notificationPosition    String   @default("bottom-left") @map("notification_position") // bottom-left, bottom-right, top-left, top-right
  // Status
  isActive                Boolean  @default(true) @map("is_active")
  // Timestamps
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@map("social_proof_config")
  @@schema("apolo")
}

// ============================================
// RETURNS & REFUNDS
// ============================================

enum ReturnStatus {
  PENDING       // Customer submitted, awaiting admin review
  APPROVED      // Admin approved, awaiting product return
  RECEIVED      // Product received back
  REFUNDED      // Refund processed
  REJECTED      // Return request rejected
  CANCELLED     // Cancelled by customer

  @@schema("apolo")
}

enum ReturnReason {
  DEFECTIVE         // Product is defective or damaged
  WRONG_ITEM        // Wrong item delivered
  NOT_AS_DESCRIBED  // Product not as described
  CHANGED_MIND      // Customer changed mind
  SIZE_FIT          // Size/fit issues
  QUALITY           // Quality not as expected
  LATE_DELIVERY     // Delivered too late
  OTHER             // Other reason

  @@schema("apolo")
}

enum RefundMethod {
  ORIGINAL_PAYMENT  // Refund to original payment method
  STORE_CREDIT      // Issue store credit
  BANK_TRANSFER     // Manual bank transfer

  @@schema("apolo")
}

model Return {
  id              String        @id @default(cuid())
  returnNumber    String        @unique @map("return_number") // e.g., RET-2025-0001
  orderId         String        @map("order_id")
  customerId      String        @map("customer_id")
  // Return details
  status          ReturnStatus  @default(PENDING)
  reason          ReturnReason
  reasonDetails   String?       @map("reason_details") @db.Text // Additional details from customer
  // Items being returned (can be partial return)
  items           Json          // Array of { orderItemId, productId, productName, quantity, priceUsd }
  // Refund information
  refundAmountUsd Decimal?      @map("refund_amount_usd") @db.Decimal(10, 2)
  refundAmountKhr Int?          @map("refund_amount_khr")
  refundMethod    RefundMethod? @map("refund_method")
  // Shipping label (optional)
  shippingLabel   String?       @map("shipping_label") @db.Text // URL or reference to shipping label
  trackingNumber  String?       @map("tracking_number") // Return shipment tracking
  // Admin processing
  adminNotes      String?       @map("admin_notes") @db.Text
  processedBy     String?       @map("processed_by") // Admin user ID who processed
  approvedAt      DateTime?     @map("approved_at")
  receivedAt      DateTime?     @map("received_at")
  refundedAt      DateTime?     @map("refunded_at")
  rejectedAt      DateTime?     @map("rejected_at")
  rejectionReason String?       @map("rejection_reason") @db.Text
  // Timestamps
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([customerId])
  @@index([status])
  @@index([returnNumber])
  @@index([createdAt])
  @@map("returns")
  @@schema("apolo")
}

// ============================================
// TAX CALCULATION
// ============================================

enum TaxType {
  VAT             // Value Added Tax
  SALES_TAX       // Sales Tax
  GST             // Goods and Services Tax
  CUSTOM          // Custom tax type

  @@schema("apolo")
}

enum TaxPricingMode {
  EXCLUSIVE       // Tax added on top of price (default)
  INCLUSIVE       // Tax included in displayed price

  @@schema("apolo")
}

model TaxRate {
  id            String    @id @default(cuid())
  // Location-based tax
  country       String    // ISO 3166-1 alpha-2 code (e.g., "KH", "US")
  countryName   String    @map("country_name") // Human-readable name (e.g., "Cambodia")
  region        String?   // Region/State/Province (null = applies to entire country)
  regionName    String?   @map("region_name") // Human-readable region name
  // Tax details
  name          String    // Tax name (e.g., "Cambodia VAT", "Sales Tax")
  rate          Decimal   @db.Decimal(5, 4) // Rate as decimal (0.10 = 10%)
  taxType       TaxType   @default(VAT) @map("tax_type")
  // Product type specific rates (null = applies to all products)
  categoryId    String?   @map("category_id") // If set, applies only to this category
  // Tax settings
  pricingMode   TaxPricingMode @default(EXCLUSIVE) @map("pricing_mode")
  isDefault     Boolean   @default(false) @map("is_default") // Default rate for the country
  isActive      Boolean   @default(true) @map("is_active")
  // Metadata
  description   String?   @db.Text // Additional info about this tax rate
  effectiveFrom DateTime? @map("effective_from") // When this rate becomes effective
  effectiveTo   DateTime? @map("effective_to") // When this rate expires (null = no expiry)
  // Timestamps
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  taxLogs       TaxLog[]

  @@unique([country, region, categoryId]) // One rate per country+region+category combination
  @@index([country])
  @@index([region])
  @@index([categoryId])
  @@index([isActive])
  @@index([isDefault])
  @@map("tax_rates")
  @@schema("apolo")
}

// Tax applied to orders for reporting and audit
model TaxLog {
  id            String    @id @default(cuid())
  orderId       String    @map("order_id")
  taxRateId     String?   @map("tax_rate_id") // Nullable if tax rate is deleted
  taxRate       TaxRate?  @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  // Snapshot of tax details at time of order (for audit)
  taxName       String    @map("tax_name")
  taxRateValue  Decimal   @map("tax_rate_value") @db.Decimal(5, 4) // Rate at time of order
  taxType       TaxType   @map("tax_type")
  pricingMode   TaxPricingMode @map("pricing_mode")
  country       String
  region        String?
  // Amounts
  subtotalUsd   Decimal   @map("subtotal_usd") @db.Decimal(10, 2) // Pre-tax subtotal
  subtotalKhr   Int       @map("subtotal_khr")
  taxAmountUsd  Decimal   @map("tax_amount_usd") @db.Decimal(10, 2) // Tax amount
  taxAmountKhr  Int       @map("tax_amount_khr")
  // Timestamps
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([orderId])
  @@index([taxRateId])
  @@index([createdAt])
  @@index([country])
  @@map("tax_logs")
  @@schema("apolo")
}

// ============================================
// MULTI-CURRENCY SUPPORT
// ============================================

// Exchange rates for multi-currency support
model ExchangeRate {
  id              String    @id @default(cuid())
  baseCurrency    Currency  @default(USD) @map("base_currency")
  targetCurrency  Currency  @map("target_currency")
  rate            Decimal   @db.Decimal(18, 8) // Exchange rate (1 base = X target)
  inverseRate     Decimal   @db.Decimal(18, 8) @map("inverse_rate") // 1 target = X base
  // Conversion fee settings
  conversionFee   Decimal   @default(0) @db.Decimal(5, 4) @map("conversion_fee") // Fee as decimal (0.02 = 2%)
  // Source and freshness
  source          String    @default("manual") // "manual", "openexchangerates", "fixer", etc.
  fetchedAt       DateTime  @default(now()) @map("fetched_at") // When rate was fetched
  expiresAt       DateTime? @map("expires_at") // When rate expires (for caching)
  // Status
  isActive        Boolean   @default(true) @map("is_active")
  // Timestamps
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([baseCurrency, targetCurrency])
  @@index([baseCurrency])
  @@index([targetCurrency])
  @@index([isActive])
  @@index([fetchedAt])
  @@map("exchange_rates")
  @@schema("apolo")
}

// Log of currency conversions for orders (audit trail)
model CurrencyConversionLog {
  id              String    @id @default(cuid())
  orderId         String?   @map("order_id")
  // Conversion details
  fromCurrency    Currency  @map("from_currency")
  toCurrency      Currency  @map("to_currency")
  originalAmount  Decimal   @map("original_amount") @db.Decimal(18, 2)
  convertedAmount Decimal   @map("converted_amount") @db.Decimal(18, 2)
  exchangeRate    Decimal   @map("exchange_rate") @db.Decimal(18, 8) // Rate used
  conversionFee   Decimal   @default(0) @map("conversion_fee") @db.Decimal(18, 2) // Fee amount
  feePercentage   Decimal   @default(0) @map("fee_percentage") @db.Decimal(5, 4) // Fee % applied
  // Settlement
  settlementCurrency Currency @default(USD) @map("settlement_currency") // Shop's base currency
  settlementAmount Decimal  @map("settlement_amount") @db.Decimal(18, 2)
  // Metadata
  customerCountry String?   @map("customer_country") // ISO country code
  detectedCurrency Currency? @map("detected_currency") // Auto-detected currency
  // Timestamps
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([orderId])
  @@index([fromCurrency])
  @@index([toCurrency])
  @@index([createdAt])
  @@map("currency_conversion_logs")
  @@schema("apolo")
}

// Currency configuration for shops
model CurrencyConfig {
  id              String    @id @default(cuid())
  clientId        String?   @map("client_id") @unique
  // Base currency (shop settles in this currency)
  baseCurrency    Currency  @default(USD) @map("base_currency")
  // Enabled currencies for display
  enabledCurrencies Json    @default("[]") @map("enabled_currencies") // Array of Currency codes
  // Auto-detection settings
  autoDetectEnabled Boolean @default(true) @map("auto_detect_enabled")
  defaultCurrency Currency @default(USD) @map("default_currency") // Fallback when detection fails
  // Fee settings
  conversionFeeEnabled Boolean @default(false) @map("conversion_fee_enabled")
  conversionFeePercent Decimal @default(0) @db.Decimal(5, 4) @map("conversion_fee_percent")
  displayConversionFee Boolean @default(true) @map("display_conversion_fee") // Show fee to customer
  // Rate update settings
  rateUpdateFrequency String @default("daily") @map("rate_update_frequency") // "manual", "hourly", "daily"
  rateApiProvider String? @map("rate_api_provider") // "openexchangerates", "fixer", etc.
  rateApiKey String? @map("rate_api_key") // Encrypted API key
  // Timestamps
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([baseCurrency])
  @@map("currency_configs")
  @@schema("apolo")
}

// ============================================
// PRODUCT SUBSCRIPTIONS (Subscribe & Save)
// ============================================

enum SubscriptionFrequency {
  WEEKLY       // Every week
  BIWEEKLY     // Every 2 weeks
  MONTHLY      // Every month
  BIMONTHLY    // Every 2 months
  QUARTERLY    // Every 3 months

  @@schema("apolo")
}

enum ProductSubscriptionStatus {
  ACTIVE       // Subscription is active
  PAUSED       // Temporarily paused by customer
  CANCELLED    // Cancelled by customer
  EXPIRED      // Subscription ended

  @@schema("apolo")
}

model ProductSubscription {
  id              String                   @id @default(cuid())
  customerId      String                   @map("customer_id")
  customer        Customer                 @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId       String                   @map("product_id")
  product         Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Variant support (optional)
  variantId       String?                  @map("variant_id")
  variant         ProductVariant?          @relation(fields: [variantId], references: [id], onDelete: SetNull)
  // Subscription details
  quantity        Int                      @default(1)
  frequency       SubscriptionFrequency    @default(MONTHLY)
  // Custom frequency (if frequency is CUSTOM)
  customDays      Int?                     @map("custom_days") // Days between deliveries for custom frequency
  // Discount
  discountPercent Int                      @default(10) @map("discount_percent") // Subscribe & Save discount (default 10%)
  // Schedule
  nextDeliveryAt  DateTime                 @map("next_delivery_at")
  lastDeliveryAt  DateTime?                @map("last_delivery_at")
  // Status
  status          ProductSubscriptionStatus @default(ACTIVE)
  pausedAt        DateTime?                @map("paused_at")
  pausedUntil     DateTime?                @map("paused_until") // Optional: auto-resume date
  cancelledAt     DateTime?                @map("cancelled_at")
  cancelReason    String?                  @map("cancel_reason") @db.Text
  // Delivery address
  shippingAddressId String?                @map("shipping_address_id")
  // Order tracking
  totalOrders     Int                      @default(0) @map("total_orders")
  totalSpentUsd   Decimal                  @default(0) @map("total_spent_usd") @db.Decimal(10, 2)
  // Timestamps
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  deliveries      SubscriptionDelivery[]

  @@index([customerId])
  @@index([productId])
  @@index([variantId])
  @@index([status])
  @@index([nextDeliveryAt])
  @@map("product_subscriptions")
  @@schema("apolo")
}

// Track each delivery/order created from subscription
model SubscriptionDelivery {
  id              String                @id @default(cuid())
  subscriptionId  String                @map("subscription_id")
  subscription    ProductSubscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  orderId         String?               @map("order_id") // Link to created order
  // Delivery details
  scheduledAt     DateTime              @map("scheduled_at")
  processedAt     DateTime?             @map("processed_at")
  // Status
  status          String                @default("pending") // pending, processed, failed, skipped
  skipReason      String?               @map("skip_reason") @db.Text // Reason if skipped
  // Pricing snapshot at time of delivery
  priceUsd        Decimal               @map("price_usd") @db.Decimal(10, 2)
  discountPercent Int                   @map("discount_percent")
  finalPriceUsd   Decimal               @map("final_price_usd") @db.Decimal(10, 2)
  // Timestamps
  createdAt       DateTime              @default(now()) @map("created_at")

  @@index([subscriptionId])
  @@index([orderId])
  @@index([scheduledAt])
  @@index([status])
  @@map("subscription_deliveries")
  @@schema("apolo")
}

// ============================================
// STOCK NOTIFICATIONS
// ============================================

// Back-in-stock notification requests
model StockNotification {
  id        String    @id @default(cuid())
  productId String    @map("product_id")
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  email     String
  // Status tracking
  notified  Boolean   @default(false)
  notifiedAt DateTime? @map("notified_at")
  // Customer tracking (optional - can be linked to existing customer)
  customerId String?  @map("customer_id")
  // Timestamps
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@unique([productId, email]) // One notification request per email per product
  @@index([productId])
  @@index([email])
  @@index([notified])
  @@index([customerId])
  @@map("stock_notifications")
  @@schema("apolo")
}

// ============================================
// PRODUCT Q&A
// ============================================

// Questions asked about products
model ProductQuestion {
  id         String   @id @default(cuid())
  productId  String   @map("product_id")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Question details
  question   String   @db.Text
  // Author (either registered customer or guest)
  customerId String?  @map("customer_id")
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  guestName  String?  @map("guest_name") // For guest questions
  guestEmail String?  @map("guest_email") // To notify when answered
  // Moderation
  status     QuestionStatus @default(PENDING)
  // Timestamps
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  answers    ProductAnswer[]

  @@index([productId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("product_questions")
  @@schema("apolo")
}

// Answers to product questions
model ProductAnswer {
  id          String   @id @default(cuid())
  questionId  String   @map("question_id")
  question    ProductQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  // Answer details
  answer      String   @db.Text
  // Author (either admin/seller, registered customer, or guest)
  isOfficial  Boolean  @default(false) @map("is_official") // True if answered by admin/seller
  customerId  String?  @map("customer_id")
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  guestName   String?  @map("guest_name") // For guest answers
  // Voting
  helpfulVotes   Int   @default(0) @map("helpful_votes")
  unhelpfulVotes Int   @default(0) @map("unhelpful_votes")
  // Timestamps
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  votes       AnswerVote[]

  @@index([questionId])
  @@index([customerId])
  @@index([isOfficial])
  @@index([helpfulVotes])
  @@map("product_answers")
  @@schema("apolo")
}

// Track individual votes on answers to prevent duplicates
model AnswerVote {
  id        String   @id @default(cuid())
  answerId  String   @map("answer_id")
  answer    ProductAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  // Voter identification (IP-based for guests, customerId for registered)
  customerId String? @map("customer_id")
  ipAddress  String? @map("ip_address") // For guest voting
  // Vote type
  isHelpful  Boolean @map("is_helpful") // true = helpful, false = unhelpful
  // Timestamps
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([answerId, customerId]) // One vote per customer per answer
  @@unique([answerId, ipAddress]) // One vote per IP per answer (for guests)
  @@index([answerId])
  @@index([customerId])
  @@map("answer_votes")
  @@schema("apolo")
}

enum QuestionStatus {
  PENDING   // Awaiting moderation
  APPROVED  // Visible on product page
  REJECTED  // Not displayed
  @@schema("apolo")
}

// ============================================
// SIZE GUIDE & FIT FINDER (US-091)
// ============================================

// Size chart that can be linked to products or categories
model SizeChart {
  id          String   @id @default(cuid())
  nameEn      String   @map("name_en") // e.g., "Women's Clothing"
  nameKh      String   @map("name_kh")
  brandEn     String?  @map("brand_en") // Optional brand name for comparison
  brandKh     String?  @map("brand_kh")
  // Chart type for different product types
  chartType   SizeChartType @default(CLOTHING) @map("chart_type")
  // Measurement unit
  unit        MeasurementUnit @default(CM)
  // Size definitions as JSON array
  // [{ size: "S", measurements: { chest: 88, waist: 68, hips: 94 } }, ...]
  sizes       Json
  // Which measurements are included (for display)
  // ["chest", "waist", "hips", "length", "shoulder"]
  measurementTypes Json @map("measurement_types")
  // Optional image showing how to measure
  measurementGuideImage String? @map("measurement_guide_image")
  // Fit type (for fit recommendations)
  fitType     FitType @default(REGULAR)
  // Relations
  categoryId  String? @map("category_id")
  productId   String? @map("product_id")
  // Active status
  isActive    Boolean @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([categoryId])
  @@index([productId])
  @@index([chartType])
  @@index([isActive])
  @@map("size_charts")
  @@schema("apolo")
}

// Customer size profile for storing their measurements
model SizeProfile {
  id          String   @id @default(cuid())
  customerId  String?  @map("customer_id")
  guestId     String?  @map("guest_id") // For guest users (stored in localStorage on client)
  // Personal info for fit recommendations
  gender      Gender?
  height      Decimal? @db.Decimal(5, 2) // in cm
  weight      Decimal? @db.Decimal(5, 2) // in kg
  age         Int?
  // Body measurements (all in cm)
  chest       Decimal? @db.Decimal(5, 2)
  waist       Decimal? @db.Decimal(5, 2)
  hips        Decimal? @db.Decimal(5, 2)
  inseam      Decimal? @db.Decimal(5, 2) // leg length
  shoulder    Decimal? @db.Decimal(5, 2)
  armLength   Decimal? @map("arm_length") @db.Decimal(5, 2)
  footLength  Decimal? @map("foot_length") @db.Decimal(5, 2) // in cm
  footWidth   Decimal? @map("foot_width") @db.Decimal(5, 2) // in cm
  // Fit preferences
  preferredFit FitType @default(REGULAR) @map("preferred_fit")
  // Saved sizes per category/brand
  // { "tops": "M", "bottoms": "L", "shoes": "42", "brand:Nike:shoes": "43" }
  savedSizes  Json?    @map("saved_sizes")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([customerId])
  @@unique([guestId])
  @@index([customerId])
  @@index([guestId])
  @@map("size_profiles")
  @@schema("apolo")
}

// Store fit quiz responses for analytics and recommendations
model FitQuizResponse {
  id              String   @id @default(cuid())
  customerId      String?  @map("customer_id")
  guestId         String?  @map("guest_id")
  productId       String?  @map("product_id") // Product being sized
  sizeChartId     String?  @map("size_chart_id") // Size chart used
  // Quiz answers stored as JSON
  // { "height": 170, "weight": 65, "bodyType": "athletic", "fitPreference": "regular" }
  answers         Json
  // Recommended size from quiz
  recommendedSize String   @map("recommended_size")
  // User feedback (did they buy this size? did it fit?)
  purchasedSize   String?  @map("purchased_size") // What they actually bought
  fitFeedback     FitFeedback? @map("fit_feedback") // How it fit
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([guestId])
  @@index([productId])
  @@index([sizeChartId])
  @@index([recommendedSize])
  @@map("fit_quiz_responses")
  @@schema("apolo")
}

enum SizeChartType {
  CLOTHING      // General clothing (tops, bottoms)
  SHOES         // Footwear
  ACCESSORIES   // Bags, hats, etc.
  JEWELRY       // Rings, bracelets
  KIDS          // Children's sizes
  @@schema("apolo")
}

enum MeasurementUnit {
  CM            // Centimeters
  INCH          // Inches
  @@schema("apolo")
}

enum FitType {
  SLIM          // Fitted/tight
  REGULAR       // Standard fit
  RELAXED       // Loose/comfortable
  OVERSIZED     // Extra loose/baggy
  @@schema("apolo")
}

enum Gender {
  MALE
  FEMALE
  UNISEX
  @@schema("apolo")
}

enum FitFeedback {
  TOO_SMALL     // Size was too small
  SLIGHTLY_SMALL // Slightly tight
  PERFECT       // Just right
  SLIGHTLY_LARGE // Slightly loose
  TOO_LARGE     // Size was too large
  @@schema("apolo")
}
