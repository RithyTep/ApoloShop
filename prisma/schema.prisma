  shopStatus      String?  @map("shop_status") // ACTIVE, PENDING, SUSPENDED
  // Connection status
  status          TikTokAccountStatus @default(ACTIVE)
  lastSyncAt      DateTime? @map("last_sync_at")
  syncError       String?  @map("sync_error") @db.Text
  // Settings
  autoSync        Boolean  @default(true) @map("auto_sync")
  syncProducts    Boolean  @default(true) @map("sync_products")
  syncOrders      Boolean  @default(true) @map("sync_orders")
