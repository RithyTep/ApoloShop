// ============================================
// MULTI-TENANT CLIENT
// ============================================

model Client {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique // Used for subdomains: {slug}.apoloshop.com
  domain       String?  @unique // Custom domain: shop.example.com
  settings     Json?    // Client-specific settings (currency, language, etc.)
  // Theme fields for whitelabel branding
  primaryColor   String?  @map("primary_color")      // e.g., "oklch(0.72 0.16 356)"
  secondaryColor String?  @map("secondary_color")    // e.g., "oklch(0.65 0.15 250)"
  logoUrl        String?  @map("logo_url")           // URL to client's logo
